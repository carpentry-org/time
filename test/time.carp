(load "Test.carp")
(load "../time.carp")
(use Test)

; a Datetime with a time-of-day and a timezone, no nanoseconds — keeps the
; timezone-conversion assertions below readable.
(defn at-tz [y mo d h mi s tz]
  (Datetime.init y
                 mo
                 d
                 (Maybe.Just h)
                 (Maybe.Just mi)
                 (Maybe.Just s)
                 (Maybe.Nothing)
                 (Maybe.Just tz)))

; render a Datetime as "YYYY-MM-DD HH:MM:SS" for whole-instant comparisons.
(defn stamp [dt] (fmt "%s %s" &(Datetime.isoformat dt) &(Datetime.isotime dt)))

; parts stay under 2^31: a wider Long literal truncates where C long is 32 bits.
(defn nanos [secs ns]
  (let [billion (Uint64.from-long 1000000000l)]
    (+ (* (Uint64.from-long secs) billion) (Uint64.from-long ns))))

; a Datetime with a time-of-day and no timezone.
(defn at [y mo d h mi s]
  (Datetime.init y
                 mo
                 d
                 (Maybe.Just h)
                 (Maybe.Just mi)
                 (Maybe.Just s)
                 (Maybe.Nothing)
                 (Maybe.Nothing)))

; seconds since the epoch, from a day count and a time of day (see `nanos`).
(defn epoch-at [days tod]
  (+ (* (Long.from-int days) 86400l) (Long.from-int tod)))

; n UTF-8 continuation bytes, which decode to no character at all.
(defn conts [n] (String.from-bytes &(Array.replicate n &128b)))

; sweep range: two leap years, two 53-week ISO years (2020 and 2026)
(def SWEEP-FROM (Datetime.to-ordinal &(Datetime.date 2018 1 1)))
(def SWEEP-TO (Datetime.to-ordinal &(Datetime.date 2026 12 31)))

; round-trips every date from ordinal `from` to `to`, returning the first failure
(defn roundtrip-sweep [from to f]
  (let-do [bad @""
           ord from]
    (while-do (and (String.empty? &bad) (<= ord to))
      (let [d (Datetime.from-ordinal ord)
            s (Datetime.strftime &d f)]
        (match (Datetime.strptime &s f)
          (Result.Success p)
            (unless (Datetime.= &p &d)
              (set! bad
                    (fmt "%s: %s -> %s -> %s"
                         f
                         &(Datetime.isoformat &d)
                         &s
                         &(Datetime.isoformat &p))))
          (Result.Error e)
            (set! bad
                  (fmt "%s: %s -> %s -> %s" f &(Datetime.isoformat &d) &s &e))))
      (set! ord (Int.inc ord)))
    bad))

(deftest test
  (assert-equal test
    2024
    @(Datetime.year &(Datetime.date 2024 3 15))
    "date creates correct year")
  (assert-equal test
    3
    @(Datetime.month &(Datetime.date 2024 3 15))
    "date creates correct month")
  (assert-equal test
    15
    @(Datetime.day &(Datetime.date 2024 3 15))
    "date creates correct day")
  (assert-true test
    (Maybe.nothing? (Datetime.hours &(Datetime.date 2024 3 15)))
    "date has no hours")
  (assert-true test
    (Maybe.nothing? (Datetime.minutes &(Datetime.date 2024 3 15)))
    "date has no minutes")
  (assert-true test
    (Maybe.nothing? (Datetime.seconds &(Datetime.date 2024 3 15)))
    "date has no seconds")

  (assert-true test
    (Datetime.leap? &(Datetime.date 2000 1 1))
    "2000 is a leap year")
  (assert-true test
    (Datetime.leap? &(Datetime.date 2024 1 1))
    "2024 is a leap year")
  (assert-false test
    (Datetime.leap? &(Datetime.date 1900 1 1))
    "1900 is not a leap year")
  (assert-false test
    (Datetime.leap? &(Datetime.date 2023 1 1))
    "2023 is not a leap year")

  (assert-equal test
    1
    (Datetime.to-ordinal &(Datetime.date 1 1 1))
    "ordinal of 0001-01-01 is 1")
  (assert-equal test
    730120
    (Datetime.to-ordinal &(Datetime.date 2000 1 1))
    "ordinal of 2000-01-01")
  (assert-equal test
    &(Datetime.date 2000 1 1)
    &(Datetime.from-ordinal 730120)
    "from-ordinal roundtrips with 2000-01-01")
  (assert-equal test
    &(Datetime.date 1 1 1)
    &(Datetime.from-ordinal 1)
    "from-ordinal of 1 is 0001-01-01")

  (assert-equal test
    4
    (Datetime.weekday &(Datetime.date 2024 3 15))
    "2024-03-15 is weekday 4 (Friday)")
  (assert-equal test
    5
    (Datetime.isoweekday &(Datetime.date 2024 3 15))
    "2024-03-15 is isoweekday 5 (Friday)")
  (assert-equal test
    0
    (Datetime.weekday &(Datetime.date 2024 3 18))
    "2024-03-18 is weekday 0 (Monday)")
  (assert-equal test
    1
    (Datetime.isoweekday &(Datetime.date 2024 3 18))
    "2024-03-18 is isoweekday 1 (Monday)")

  (assert-equal test
    1
    (Datetime.yearday &(Datetime.date 2024 1 1))
    "Jan 1 is yearday 1")
  (assert-equal test
    60
    (Datetime.yearday &(Datetime.date 2024 2 29))
    "Feb 29 in leap year is yearday 60")
  (assert-equal test
    365
    (Datetime.yearday &(Datetime.date 2023 12 31))
    "Dec 31 in non-leap year is yearday 365")
  (assert-equal test
    61
    (Datetime.yearday &(Datetime.date 2024 3 1))
    "March 1 in a leap year is yearday 61 (leap day counted)")
  (assert-equal test
    366
    (Datetime.yearday &(Datetime.date 2024 12 31))
    "Dec 31 in a leap year is yearday 366")
  (assert-equal test
    60
    (Datetime.yearday &(Datetime.date 2023 3 1))
    "March 1 in a non-leap year is yearday 60")

  (assert-equal test
    &@"Friday"
    &(Datetime.weekday-string &(Datetime.date 2024 3 15))
    "weekday-string of Friday")
  (assert-equal test
    &@"Fri"
    &(Datetime.weekday-short-string &(Datetime.date 2024 3 15))
    "weekday-short-string of Friday")
  (assert-equal test
    &@"Monday"
    &(Datetime.weekday-string &(Datetime.date 2024 3 18))
    "weekday-string of Monday")

  (assert-equal test
    &@"March"
    &(Datetime.month-string &(Datetime.date 2024 3 15))
    "month-string of March")
  (assert-equal test
    &@"Mar"
    &(Datetime.month-short-string &(Datetime.date 2024 3 15))
    "month-short-string of March")
  (assert-equal test
    &@"January"
    &(Datetime.month-string &(Datetime.date 2024 1 1))
    "month-string of January")
  (assert-equal test
    &@"December"
    &(Datetime.month-string &(Datetime.date 2024 12 25))
    "month-string of December")

  (assert-equal test
    &@"2024-03-15"
    &(Datetime.isoformat &(Datetime.date 2024 3 15))
    "isoformat of 2024-03-15")
  (assert-equal test
    &@"0001-01-01"
    &(Datetime.isoformat &(Datetime.date 1 1 1))
    "isoformat zero-pads year")
  (assert-equal test
    &@"00:00:00"
    &(Datetime.isotime &(Datetime.date 2024 3 15))
    "isotime defaults to 00:00:00 for date-only")
  (assert-equal test
    &@"14:30:45"
    &(Datetime.isotime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 14)
                      (Maybe.Just 30)
                      (Maybe.Just 45)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "isotime with explicit time")

  (assert-true test
    (Datetime.utc? &(Datetime.date 2024 3 15))
    "date with no timezone is utc")
  (assert-true test
    (Datetime.utc?
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Just @&Timezone.utc)))
    "date with UTC timezone is utc")
  (assert-true test
    (Datetime.utc?
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"utc" 0l false))))
    "date with lowercase utc timezone is utc")
  (assert-true test
    (Datetime.utc?
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"Utc" 0l false))))
    "date with mixed case Utc timezone is utc")
  (assert-false test
    (Datetime.utc?
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"EST" -18000l false))))
    "date with non-UTC timezone is not utc")

  (assert-true test
    (= &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 15))
    "equal dates are equal")
  (assert-false test
    (= &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 16))
    "different dates are not equal")

  (assert-equal test
    0l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1970
                      1
                      1
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "unix epoch is timestamp 0")
  ; midnight EST (UTC-5) is 05:00 UTC, i.e. 18000 seconds past the epoch; the
  ; timezone offset must be subtracted from the wall-clock, not added
  (assert-equal test
    18000l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1970
                      1
                      1
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"EST" -18000l false))))
    "to-unix-timestamp subtracts a negative (west-of-UTC) offset")
  ; 1970-01-02 00:00 at UTC+5 is 1970-01-01 19:00 UTC = 86400 - 18000 = 68400
  (assert-equal test
    68400l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1970
                      1
                      2
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"PKT" 18000l false))))
    "to-unix-timestamp subtracts a positive (east-of-UTC) offset")
  (assert-equal test
    &(Datetime.init 1970
                    1
                    1
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp 0l)
    "from-unix-timestamp 0 is epoch")
  ; Feb 29 leap year round-trip (1972 is a leap year, ts = 68169600)
  (assert-equal test
    &(Datetime.init 1972
                    2
                    29
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp
      (Datetime.to-unix-timestamp
        &(Datetime.init 1972
                        2
                        29
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))))
    "from-unix-timestamp round-trips Feb 29 in leap year")
  ; March 1 leap year round-trip (month >= 3 needs leap-day offset in to-unix)
  (assert-equal test
    &(Datetime.init 1972
                    3
                    1
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp
      (Datetime.to-unix-timestamp
        &(Datetime.init 1972
                        3
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))))
    "from-unix-timestamp round-trips March 1 in leap year")

  ; known UTC values, cross-checked against the standard Unix epoch. 1971-01-01
  ; is one non-leap year (365 days) past the epoch; this input previously
  ; SIGABRTed in both directions.
  (assert-equal test
    31536000l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1971
                      1
                      1
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp of 1971-01-01")
  (assert-equal test
    &(Datetime.init 1971
                    1
                    1
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp 31536000l)
    "from-unix-timestamp of 1971-01-01")
  ; 2023-12-31 23:59:59 (one second before 2024) previously produced a day-ZERO
  ; date of 2024-1-0
  (assert-equal test
    1704067199l
    (Datetime.to-unix-timestamp
      &(Datetime.init 2023
                      12
                      31
                      (Maybe.Just 23)
                      (Maybe.Just 59)
                      (Maybe.Just 59)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp of 2023-12-31 23:59:59")
  (assert-equal test
    &(Datetime.init 2023
                    12
                    31
                    (Maybe.Just 23)
                    (Maybe.Just 59)
                    (Maybe.Just 59)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp 1704067199l)
    "from-unix-timestamp of 2023-12-31 23:59:59")
  ; 1000000000 is 2001-09-09 01:46:40 UTC
  (assert-equal test
    1000000000l
    (Datetime.to-unix-timestamp
      &(Datetime.init 2001
                      9
                      9
                      (Maybe.Just 1)
                      (Maybe.Just 46)
                      (Maybe.Just 40)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp of 2001-09-09 01:46:40")
  (assert-equal test
    &(Datetime.init 2001
                    9
                    9
                    (Maybe.Just 1)
                    (Maybe.Just 46)
                    (Maybe.Just 40)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp 1000000000l)
    "from-unix-timestamp of 2001-09-09 01:46:40")
  ; the 32-bit time_t maximum: 2038-01-19 03:14:07 UTC = 2147483647
  (assert-equal test
    2147483647l
    (Datetime.to-unix-timestamp
      &(Datetime.init 2038
                      1
                      19
                      (Maybe.Just 3)
                      (Maybe.Just 14)
                      (Maybe.Just 7)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp at the 32-bit boundary")
  (assert-equal test
    &(Datetime.init 2038
                    1
                    19
                    (Maybe.Just 3)
                    (Maybe.Just 14)
                    (Maybe.Just 7)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp 2147483647l)
    "from-unix-timestamp at the 32-bit boundary")
  (assert-equal test
    (+ (Long.from-int Int.MAX) 1l)
    (Datetime.to-unix-timestamp &(at 2038 1 19 3 14 8))
    "to-unix-timestamp one second past the 32-bit maximum")
  (assert-equal test
    &@"2038-01-19 03:14:08"
    &(stamp &(Datetime.from-unix-timestamp (+ (Long.from-int Int.MAX) 1l)))
    "from-unix-timestamp one second past the 32-bit maximum")
  ; 2100-01-01 is 47482 days past the epoch, 2262-04-11 is 106751
  (assert-equal test
    (epoch-at 47482 0)
    (Datetime.to-unix-timestamp &(at 2100 1 1 0 0 0))
    "to-unix-timestamp of 2100-01-01")
  (assert-equal test
    &@"2100-01-01 00:00:00"
    &(stamp &(Datetime.from-unix-timestamp (epoch-at 47482 0)))
    "from-unix-timestamp of 2100-01-01")
  (assert-equal test
    (epoch-at 106751 0)
    (Datetime.to-unix-timestamp &(at 2262 4 11 0 0 0))
    "to-unix-timestamp of 2262-04-11")
  (assert-equal test
    &@"2262-04-11 12:34:56"
    &(stamp
      &(Datetime.from-unix-timestamp
        (Datetime.to-unix-timestamp &(at 2262 4 11 12 34 56))))
    "from-unix-timestamp round-trips a date past 2038")
  (assert-equal test
    (- (Long.from-int Int.MIN) 1l)
    (Datetime.to-unix-timestamp &(at 1901 12 13 20 45 51))
    "to-unix-timestamp one second before the 32-bit minimum")
  (assert-equal test
    &@"1901-12-13 20:45:51"
    &(stamp &(Datetime.from-unix-timestamp (- (Long.from-int Int.MIN) 1l)))
    "from-unix-timestamp one second before the 32-bit minimum")
  ; negative timestamps (pre-1970). / and mod truncate toward zero in Carp, so
  ; the time-of-day must be floored to stay in 0..86399.
  (assert-equal test
    -1l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1969
                      12
                      31
                      (Maybe.Just 23)
                      (Maybe.Just 59)
                      (Maybe.Just 59)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp one second before the epoch is -1")
  (assert-equal test
    &(Datetime.init 1969
                    12
                    31
                    (Maybe.Just 23)
                    (Maybe.Just 59)
                    (Maybe.Just 59)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp -1l)
    "from-unix-timestamp of -1 is one second before the epoch")
  (assert-equal test
    &(Datetime.init 1969
                    12
                    31
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp -86400l)
    "from-unix-timestamp of -86400 is exactly one day before the epoch")
  (assert-equal test
    &(Datetime.init 1969
                    6
                    15
                    (Maybe.Just 12)
                    (Maybe.Just 30)
                    (Maybe.Just 45)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp
      (Datetime.to-unix-timestamp
        &(Datetime.init 1969
                        6
                        15
                        (Maybe.Just 12)
                        (Maybe.Just 30)
                        (Maybe.Just 45)
                        (Maybe.Nothing)
                        (Maybe.Nothing))))
    "from-unix-timestamp round-trips a pre-1970 date with a time-of-day")
  ; leap-day boundary, cross-checked against known UTC values: 1972-02-29 is
  ; 68169600 and the following day 1972-03-01 is exactly 86400 seconds later
  (assert-equal test
    68169600l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1972
                      2
                      29
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp of the leap day 1972-02-29")
  (assert-equal test
    &(Datetime.init 1972
                    2
                    29
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.from-unix-timestamp 68169600l)
    "from-unix-timestamp of the leap day 1972-02-29")
  (assert-equal test
    68256000l
    (Datetime.to-unix-timestamp
      &(Datetime.init 1972
                      3
                      1
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "to-unix-timestamp of the day after the leap day 1972-03-01")

  ; --- timezone conversion: to-utc ---
  ; 22:00 EST (UTC-5) is 03:00 UTC the next day
  (assert-equal test
    &@"2024-01-02 03:00:00"
    &(stamp
      &(Datetime.to-utc
        &(at-tz 2024 1 1 22 0 0 (Timezone.init @"EST" -18000l false))))
    "to-utc shifts a west-of-UTC wall-clock forward, across midnight")
  ; 00:30 CET (UTC+1) is 23:30 UTC the previous day (and previous year)
  (assert-equal test
    &@"2023-12-31 23:30:00"
    &(stamp
      &(Datetime.to-utc
        &(at-tz 2024 1 1 0 30 0 (Timezone.init @"CET" 3600l false))))
    "to-utc shifts an east-of-UTC wall-clock back, across a year boundary")
  ; an already-UTC Datetime is unchanged
  (assert-equal test
    &@"2024-06-01 12:00:00"
    &(stamp &(Datetime.to-utc &(at-tz 2024 6 1 12 0 0 @&Timezone.utc)))
    "to-utc leaves an already-UTC Datetime unshifted")
  ; a naive (timezone-less) Datetime is treated as UTC and only labelled
  (assert-true test
    (Datetime.utc?
      &(Datetime.to-utc
        &(Datetime.init 2024
                        6
                        1
                        (Maybe.Just 12)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))))
    "to-utc labels a naive Datetime as UTC")

  ; --- timezone conversion: in-timezone ---
  ; 22:00 EST -> 12:00 JST the next day (EST+5h=UTC, UTC+9h=JST)
  (assert-equal test
    &@"2024-01-02 12:00:00"
    &(stamp
      &(Datetime.in-timezone
        &(at-tz 2024 1 1 22 0 0 (Timezone.init @"EST" -18000l false))
        &(Timezone.init @"JST" 32400l false)))
    "in-timezone converts EST to JST preserving the instant")
  ; 03:00 UTC -> 22:00 EST the previous day
  (assert-equal test
    &@"2024-01-01 22:00:00"
    &(stamp
      &(Datetime.in-timezone &(at-tz 2024 1 2 3 0 0 @&Timezone.utc)
                             &(Timezone.init @"EST" -18000l false)))
    "in-timezone converts UTC back to EST across midnight")
  ; converting out and back preserves the original wall-clock
  (assert-equal test
    &@"2024-03-10 08:15:30"
    &(stamp
      &(Datetime.in-timezone
        &(Datetime.in-timezone
          &(at-tz 2024 3 10 8 15 30 (Timezone.init @"CET" 3600l false))
          &(Timezone.init @"JST" 32400l false))
        &(Timezone.init @"CET" 3600l false)))
    "in-timezone round-trips CET -> JST -> CET")

  ; --- instant-aware comparison ---
  ; 14:00 EST and 19:00 UTC are the same instant
  (assert-true test
    (Datetime.equal-instant?
      &(at-tz 2024 1 1 14 0 0 (Timezone.init @"EST" -18000l false))
      &(at-tz 2024 1 1 19 0 0 @&Timezone.utc))
    "equal-instant? sees 14:00 EST and 19:00 UTC as equal")
  (assert-false test
    (Datetime.equal-instant?
      &(at-tz 2024 1 1 14 0 0 (Timezone.init @"EST" -18000l false))
      &(at-tz 2024 1 1 20 0 0 @&Timezone.utc))
    "equal-instant? separates 14:00 EST from 20:00 UTC")
  (assert-true test
    (Datetime.before-instant?
      &(at-tz 2024 1 1 13 59 0 (Timezone.init @"EST" -18000l false))
      &(at-tz 2024 1 1 19 0 0 @&Timezone.utc))
    "before-instant? orders 13:59 EST before 19:00 UTC")
  (assert-true test
    (Datetime.after-instant?
      &(at-tz 2024 1 1 14 1 0 (Timezone.init @"EST" -18000l false))
      &(at-tz 2024 1 1 19 0 0 @&Timezone.utc))
    "after-instant? orders 14:01 EST after 19:00 UTC")
  ; within the same second, nanoseconds break the tie
  (assert-true test
    (Datetime.before-instant?
      &(Datetime.init 2024
                      1
                      1
                      (Maybe.Just 19)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 100)
                      (Maybe.Just @&Timezone.utc))
      &(Datetime.init 2024
                      1
                      1
                      (Maybe.Just 19)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 200)
                      (Maybe.Just @&Timezone.utc)))
    "before-instant? uses nanoseconds as a tiebreaker within a second")

  ; --- instant-aware comparison past 2038 ---
  (assert-true test
    (Datetime.after-instant? &(at-tz 2100 1 1 0 0 0 @&Timezone.utc)
                             &(at-tz 2026 1 1 0 0 0 @&Timezone.utc))
    "after-instant? orders 2100 after 2026")
  (assert-false test
    (Datetime.before-instant? &(at-tz 2100 1 1 0 0 0 @&Timezone.utc)
                              &(at-tz 2026 1 1 0 0 0 @&Timezone.utc))
    "before-instant? does not order 2100 before 2026")
  (assert-true test
    (Datetime.after-instant? &(at-tz 9999 12 31 0 0 0 @&Timezone.utc)
                             &(at-tz 2026 1 1 0 0 0 @&Timezone.utc))
    "after-instant? orders 9999 after 2026")
  ; the two seconds straddling the 32-bit epoch cliff
  (assert-true test
    (Datetime.before-instant? &(at-tz 2038 1 19 3 14 7 @&Timezone.utc)
                              &(at-tz 2038 1 19 3 14 8 @&Timezone.utc))
    "before-instant? orders across 2038-01-19 03:14:07")
  (assert-false test
    (Datetime.equal-instant? &(at-tz 2100 1 1 0 0 0 @&Timezone.utc)
                             &(at-tz 1963 11 25 17 31 44 @&Timezone.utc))
    "equal-instant? does not alias 2100 onto its wrapped pre-epoch date")
  (assert-true test
    (Datetime.equal-instant?
      &(at-tz 2100 1 1 14 0 0 (Timezone.init @"EST" -18000l false))
      &(at-tz 2100 1 1 19 0 0 @&Timezone.utc))
    "equal-instant? stays timezone-aware past 2038")

  ; --- sub-second reduction of a 64-bit clock ---
  (assert-equal test
    999999999
    (Datetime.subsecond-nanos (Uint64.from-long 999999999l))
    "subsecond-nanos leaves a count below one second alone")
  (assert-equal test
    500000000
    (Datetime.subsecond-nanos (nanos 1l 500000000l))
    "subsecond-nanos drops whole seconds")
  (assert-equal test
    294967296
    (Datetime.subsecond-nanos
      (Uint64.bit-shift-left (Uint64.from-long 1l) (Uint64.from-long 32l)))
    "subsecond-nanos reduces 2^32")
  (assert-equal test
    662882507
    (Datetime.subsecond-nanos (nanos 1787138980l 662882507l))
    "subsecond-nanos reduces a realistic monotonic-clock reading")
  (assert-equal test
    854775808
    (Datetime.subsecond-nanos
      (Uint64.bit-shift-left (Uint64.from-long 1l) (Uint64.from-long 63l)))
    "subsecond-nanos reduces 2^63")
  (assert-equal test
    709551615
    (Datetime.subsecond-nanos Uint64.MAX)
    "subsecond-nanos reduces the largest representable count")

  ; with no second boundary between the samples, now's nanos sit between them.
  (let-do [billion (Uint64.from-long 1000000000l)
           a (System.nanotime)
           dt (Datetime.now)
           b (System.nanotime)
           lo (Datetime.subsecond-nanos a)
           hi (Datetime.subsecond-nanos b)
           ns (Maybe.from @(Datetime.nanoseconds &dt) -1)
           spans-a-second? (or (> (- b a) billion) (> lo hi))]
    (assert-true test
      (or spans-a-second? (and (<= lo ns) (<= ns hi)))
      "now reads its nanoseconds off the full-width clock"))

  (assert-equal test
    &@"00:00:30"
    &(Datetime.isotime
      &(Datetime.add-seconds
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        30))
    "add 30 seconds")
  (assert-equal test
    &@"00:01:00"
    &(Datetime.isotime
      &(Datetime.add-seconds
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 30)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        30))
    "add 30 seconds wraps to next minute")
  (assert-equal test
    &@"01:00:00"
    &(Datetime.isotime
      &(Datetime.add-seconds
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        3600))
    "add 3600 seconds is one hour")
  (assert-equal test
    &@"2088-01-20 03:14:06"
    &(stamp
      &(Datetime.add-seconds
        &(Datetime.init 2020
                        1
                        1
                        (Maybe.Just 23)
                        (Maybe.Just 59)
                        (Maybe.Just 59)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        2147483647))
    "add Int.MAX seconds to a non-zero seconds field")
  (assert-equal test
    &@"1951-12-14 20:45:51"
    &(stamp
      &(Datetime.add-seconds
        &(Datetime.init 2020
                        1
                        1
                        (Maybe.Just 23)
                        (Maybe.Just 59)
                        (Maybe.Just 59)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        -2147483648))
    "add Int.MIN seconds to a non-zero seconds field")
  (assert-equal test
    &@"2063-05-18 03:33:19"
    &(stamp
      &(Datetime.add-seconds
        &(Datetime.init 1999
                        12
                        31
                        (Maybe.Just 23)
                        (Maybe.Just 59)
                        (Maybe.Just 59)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        2000000000))
    "add 2000000000 seconds")
  (assert-equal test
    &@"2056-09-09 01:46:39"
    &(stamp
      &(Datetime.add-seconds
        &(Datetime.init 2024
                        12
                        31
                        (Maybe.Just 23)
                        (Maybe.Just 59)
                        (Maybe.Just 59)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        1000000000))
    "add 1000000000 seconds")

  (assert-equal test
    &@"2024-03-15"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%Y-%m-%d")
    "strftime %Y-%m-%d")
  (assert-equal test
    &@"Fri"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%a")
    "strftime %a abbreviated weekday")
  (assert-equal test
    &@"Friday"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%A")
    "strftime %A full weekday")
  (assert-equal test
    &@"Mar"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%b")
    "strftime %b abbreviated month")
  (assert-equal test
    &@"March"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%B")
    "strftime %B full month")

  (assert-equal test
    &@"+0530"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 14)
                      (Maybe.Just 30)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"IST" 19800l false)))
      "%z")
    "strftime %z formats half-hour offset correctly")
  (assert-equal test
    &@"-0800"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 6)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Just (Timezone.init @"PST" -28800l false)))
      "%z")
    "strftime %z formats negative whole-hour offset")
  (assert-equal test
    &@"+0000"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 12)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Just @&Timezone.utc))
      "%z")
    "strftime %z formats UTC as +0000")
  (assert-equal test
    &@"12"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      "%I")
    "strftime %I renders midnight (hour 0) as 12")
  (assert-equal test
    &@"12"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 12)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      "%I")
    "strftime %I renders noon (hour 12) as 12")
  (assert-equal test
    &@"01"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 13)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      "%I")
    "strftime %I renders 13:00 as 01")
  (assert-equal test
    &@"11"
    &(Datetime.strftime
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 23)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      "%I")
    "strftime %I renders 23:00 as 11")
  (assert-equal test
    &@"061"
    &(Datetime.strftime &(Datetime.date 2024 3 1) "%j")
    "strftime %j is leap-aware after February")
  (assert-equal test
    &@"366"
    &(Datetime.strftime &(Datetime.date 2024 12 31) "%j")
    "strftime %j reaches 366 on the last day of a leap year")
  (assert-equal test
    &@"060"
    &(Datetime.strftime &(Datetime.date 2023 3 1) "%j")
    "strftime %j stays 60 for March 1 in a non-leap year")
  (assert-equal test
    &@"00"
    &(Datetime.strftime &(Datetime.date 2024 1 1) "%U")
    "strftime %U puts days before the first Sunday in week 0")
  (assert-equal test
    &@"01"
    &(Datetime.strftime &(Datetime.date 2023 1 1) "%U")
    "strftime %U starts week 1 on a January 1 that is a Sunday")
  (assert-equal test
    &@"08"
    &(Datetime.strftime &(Datetime.date 2024 3 1) "%U")
    "strftime %U is leap-aware after February")
  (assert-equal test
    &@"53"
    &(Datetime.strftime &(Datetime.date 2023 12 31) "%U")
    "strftime %U reaches week 53 on a year-ending Sunday")
  (assert-equal test
    &@"01"
    &(Datetime.strftime &(Datetime.date 2024 1 1) "%W")
    "strftime %W starts week 1 on a January 1 that is a Monday")
  (assert-equal test
    &@"00"
    &(Datetime.strftime &(Datetime.date 2023 1 1) "%W")
    "strftime %W puts a leading Sunday before the first Monday in week 0")
  (assert-equal test
    &@"09"
    &(Datetime.strftime &(Datetime.date 2024 3 1) "%W")
    "strftime %W is leap-aware after February")
  (assert-equal test
    &@"52"
    &(Datetime.strftime &(Datetime.date 2023 12 31) "%W")
    "strftime %W counts a year-ending Sunday in the preceding Monday week")

  (assert-equal test
    &[2024 11 5]
    &(Datetime.isocalendar &(Datetime.date 2024 3 15))
    "isocalendar returns [iso-year iso-week iso-weekday] for a mid-year date")
  (assert-equal test
    &[2022 52 7]
    &(Datetime.isocalendar &(Datetime.date 2023 1 1))
    "isocalendar rolls a leading Sunday back into the previous ISO year")
  (assert-equal test
    &[2025 1 1]
    &(Datetime.isocalendar &(Datetime.date 2024 12 30))
    "isocalendar rolls a trailing Monday forward into the next ISO year")
  (assert-equal test
    &[2020 53 5]
    &(Datetime.isocalendar &(Datetime.date 2021 1 1))
    "isocalendar reports week 53 for a 53-week year")
  (assert-equal test
    &@"2024"
    &(Datetime.strftime &(Datetime.date 2024 1 1) "%G")
    "strftime %G matches the calendar year mid-week")
  (assert-equal test
    &@"01"
    &(Datetime.strftime &(Datetime.date 2024 1 1) "%V")
    "strftime %V zero-pads an early week")
  (assert-equal test
    &@"1"
    &(Datetime.strftime &(Datetime.date 2024 1 1) "%u")
    "strftime %u renders Monday as 1")
  (assert-equal test
    &@"7"
    &(Datetime.strftime &(Datetime.date 2023 1 1) "%u")
    "strftime %u renders Sunday as 7")
  (assert-equal test
    &@"2022"
    &(Datetime.strftime &(Datetime.date 2023 1 1) "%G")
    "strftime %G rolls back to the previous ISO year on a leading Sunday")
  (assert-equal test
    &@"52"
    &(Datetime.strftime &(Datetime.date 2023 1 1) "%V")
    "strftime %V is week 52 of 2022 for 2023-01-01")
  (assert-equal test
    &@"2025"
    &(Datetime.strftime &(Datetime.date 2024 12 30) "%G")
    "strftime %G rolls forward to the next ISO year on a trailing Monday")
  (assert-equal test
    &@"01"
    &(Datetime.strftime &(Datetime.date 2024 12 30) "%V")
    "strftime %V is week 01 of 2025 for 2024-12-30")
  (assert-equal test
    &@"53"
    &(Datetime.strftime &(Datetime.date 2021 1 1) "%V")
    "strftime %V reaches week 53 in a 53-week year")
  (assert-equal test
    &@"2024-03-15"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%F")
    "strftime %F expands to an ISO date")
  (assert-equal test
    &@"00:00:00"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%T")
    "strftime %T expands to 24-hour time")
  (assert-equal test
    &@"00:00"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%R")
    "strftime %R is 24-hour time without seconds")
  (assert-equal test
    &@"03/15/24"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%D")
    "strftime %D is a US-style date")
  (assert-equal test
    &@"12:00:00 AM"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%r")
    "strftime %r is 12-hour time with AM/PM")
  (assert-equal test
    &@"Mar"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%h")
    "strftime %h aliases the abbreviated month name")

  (assert-equal test
    &@"Date: 2024"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "Date: %Y")
    "strftime keeps a leading literal")
  (assert-equal test
    &@"Day 15, ok"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "Day %d, ok")
    "strftime keeps a leading literal starting with a specifier letter")
  (assert-equal test
    &@"zzz 2024"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "zzz %Y")
    "strftime keeps a leading literal starting with a tz specifier letter")
  (assert-equal test
    &@"hello"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "hello")
    "strftime passes through a format with no directive")
  (assert-equal test
    &@""
    &(Datetime.strftime &(Datetime.date 2024 3 15) "")
    "strftime renders the empty format as the empty string")
  (assert-equal test
    &@"100% done 2024"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "100%% done %Y")
    "strftime renders %% as a literal percent")
  (assert-equal test
    &@"%Y"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%%Y")
    "strftime does not expand the letter after an escaped percent")
  (assert-equal test
    &@"%2024"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%%%Y")
    "strftime resumes directives after an escaped percent")
  (assert-equal test
    &@"Q"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%Q")
    "strftime renders an unknown specifier as the character itself")
  (assert-equal test
    &[195b 164b]
    &(String.to-bytes &(Datetime.strftime &(Datetime.date 2024 3 15) "%ä"))
    "strftime renders an unknown non-ASCII specifier as that character")
  (assert-equal test
    &[226b 130b 172b 120b]
    &(String.to-bytes &(Datetime.strftime &(Datetime.date 2024 3 15) "%€x"))
    "strftime reassembles a multi-byte unknown specifier before a literal")
  (assert-equal test
    &@"2024%"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%Y%")
    "strftime renders a trailing lone percent as a literal percent")
  (assert-equal test
    &@"%"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "%")
    "strftime renders a lone percent as a literal percent")
  (assert-equal test
    &@"Größe: 2024 μs"
    &(Datetime.strftime &(Datetime.date 2024 3 15) "Größe: %Y μs")
    "strftime copies non-ASCII literals verbatim")
  (assert-equal test
    &@"Größe: 2024"
    &(Datetime.format "Größe: %Y" &(Datetime.date 2024 3 15))
    "format slices non-ASCII literals by byte")
  (assert-equal test
    &@"Größe: 2024"
    &(fmt "Größe: %Y" &(Datetime.date 2024 3 15))
    "fmt reaches format with a non-ASCII literal")
  (assert-equal test
    &@"hello"
    &(Datetime.format "hello" &(Datetime.date 2024 3 15))
    "format passes through a slice with no directive")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024-03-15 11" "%Y-%m-%d %V")
    "strptime consumes %V without disturbing the parsed date")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024 2024-03-15 5" "%G %Y-%m-%d %u")
    "strptime consumes %G and %u without disturbing the parsed date")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024-03-15" "%F")
    "strptime parses %F, which expands to %Y-%m-%d")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "03/15/24" "%D")
    "strptime parses %D, which expands to %m/%d/%y")

  (assert-true test
    (> &(Datetime.date 2024 3 16) &(Datetime.date 2024 3 15))
    "later date is greater")
  (assert-true test
    (< &(Datetime.date 2024 3 14) &(Datetime.date 2024 3 15))
    "earlier date is less")

  (assert-equal test
    &@"00:05:00"
    &(Datetime.isotime
      &(Duration.add
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        &(Duration.minutes 5)))
    "Duration.add 5 minutes")
  (assert-equal test
    &@"02:00:00"
    &(Datetime.isotime
      &(Duration.add
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        &(Duration.hours 2)))
    "Duration.add 2 hours")
  (assert-equal test
    2
    @(Datetime.day
      &(Duration.add
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        &(Duration.days 1)))
    "Duration.add 1 day advances the day")
  (assert-equal test
    &@"23:55:00"
    &(Datetime.isotime
      &(Duration.sub
        &(Datetime.init 2024
                        1
                        2
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        &(Duration.minutes 5)))
    "Duration.sub 5 minutes wraps back")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024-03-15" "%Y-%m-%d")
    "strptime parses %Y-%m-%d")

  (assert-equal test
    &(Result.Success
      (Datetime.init 2024
                     3
                     15
                     (Maybe.Just 14)
                     (Maybe.Just 30)
                     (Maybe.Just 45)
                     (Maybe.Nothing)
                     (Maybe.Nothing)))
    &(Datetime.strptime "2024-03-15 14:30:45" "%Y-%m-%d %H:%M:%S")
    "strptime parses date and time")

  (assert-equal test
    2024
    (match (Datetime.strptime "24-03-15" "%y-%m-%d")
      (Result.Success dt) @(Datetime.year &dt)
      (Result.Error _) -1)
    "strptime %y parses 24 as 2024")
  (assert-equal test
    1999
    (match (Datetime.strptime "99-01-01" "%y-%m-%d")
      (Result.Success dt) @(Datetime.year &dt)
      (Result.Error _) -1)
    "strptime %y parses 99 as 1999")

  (assert-equal test
    3
    (match (Datetime.strptime "15 Mar 2024" "%d %b %Y")
      (Result.Success dt) @(Datetime.month &dt)
      (Result.Error _) -1)
    "strptime %b parses abbreviated month")

  (assert-equal test
    3
    (match (Datetime.strptime "March 15, 2024" "%B %d, %Y")
      (Result.Success dt) @(Datetime.month &dt)
      (Result.Error _) -1)
    "strptime %B parses full month name")

  (assert-equal test
    14
    (match (Datetime.strptime "02:30 PM" "%I:%M %p")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) 0)
      (Result.Error _) -1)
    "strptime %I %p parses 02 PM as 14")
  (assert-equal test
    2
    (match (Datetime.strptime "02:30 AM" "%I:%M %p")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) 0)
      (Result.Error _) -1)
    "strptime %I %p parses 02 AM as 2")
  (assert-equal test
    0
    (match (Datetime.strptime "12:00 AM" "%I:%M %p")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) -1)
      (Result.Error _) -2)
    "strptime %I %p parses 12 AM as 0")
  (assert-equal test
    12
    (match (Datetime.strptime "12:00 PM" "%I:%M %p")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) -1)
      (Result.Error _) -2)
    "strptime %I %p parses 12 PM as 12")

  (assert-equal test
    -1
    (match (Datetime.strptime "PM 2024-03-15" "%p %Y-%m-%d")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) -1)
      (Result.Error _) -2)
    "strptime %p with no hour specifier leaves the hour unset (PM)")
  (assert-equal test
    -1
    (match (Datetime.strptime "AM 2024-03-15" "%p %Y-%m-%d")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) -1)
      (Result.Error _) -2)
    "strptime %p with no hour specifier leaves the hour unset (AM)")
  (assert-equal test
    15
    (match (Datetime.strptime "03 PM 2024-03-15" "%I %p %Y-%m-%d")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) -1)
      (Result.Error _) -2)
    "strptime %I %p parses 03 PM as 15")
  (assert-equal test
    7
    (match (Datetime.strptime "07 2024-03-15" "%H %Y-%m-%d")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) -1)
      (Result.Error _) -2)
    "strptime %H parses the hour with no am/pm marker")

  (assert-equal test
    123456789
    (match (Datetime.strptime "14:30:00.123456789" "%H:%M:%S.%n")
      (Result.Success dt) (Maybe.from @(Datetime.nanoseconds &dt) 0)
      (Result.Error _) -1)
    "strptime %n parses nanoseconds")

  (assert-true test
    (match (Datetime.strptime "2024-03-15 14:30:00 +0530" "%Y-%m-%d %H:%M:%S %z")
      (Result.Success dt)
        (= 19800l
           @(Timezone.delta &(Maybe.from @(Datetime.tz &dt) (Timezone.zero))))
      (Result.Error _) false)
    "strptime %z parses +0530 offset")
  (assert-true test
    (match (Datetime.strptime "2024-03-15 14:30:00 -0800" "%Y-%m-%d %H:%M:%S %z")
      (Result.Success dt)
        (= -28800l
           @(Timezone.delta &(Maybe.from @(Datetime.tz &dt) (Timezone.zero))))
      (Result.Error _) false)
    "strptime %z parses -0800 offset")

  (assert-true test
    (match (Datetime.strptime "2024-03-15 UTC" "%Y-%m-%d %Z")
      (Result.Success dt)
        (= "UTC"
           (Timezone.name &(Maybe.from @(Datetime.tz &dt) (Timezone.zero))))
      (Result.Error _) false)
    "strptime %Z parses timezone name")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "Fri 2024-03-15" "%a %Y-%m-%d")
    "strptime %a parses and discards abbreviated weekday")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "Friday 2024-03-15" "%A %Y-%m-%d")
    "strptime %A parses and discards full weekday")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "100% 2024-03-15" "100%% %Y-%m-%d")
    "strptime %% matches literal percent")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024-03-15" "%x")
    "strptime %x parses ISO date")

  (assert-equal test
    14
    (match (Datetime.strptime "14:30:45" "%X")
      (Result.Success dt) (Maybe.from @(Datetime.hours &dt) 0)
      (Result.Error _) -1)
    "strptime %X parses ISO time hours")
  (assert-equal test
    30
    (match (Datetime.strptime "14:30:45" "%X")
      (Result.Success dt) (Maybe.from @(Datetime.minutes &dt) 0)
      (Result.Error _) -1)
    "strptime %X parses ISO time minutes")
  (assert-equal test
    45
    (match (Datetime.strptime "14:30:45" "%X")
      (Result.Success dt) (Maybe.from @(Datetime.seconds &dt) 0)
      (Result.Error _) -1)
    "strptime %X parses ISO time seconds")

  (assert-equal test
    &(Result.Success
      (Datetime.init 2024
                     3
                     15
                     (Maybe.Just 14)
                     (Maybe.Just 30)
                     (Maybe.Just 45)
                     (Maybe.Nothing)
                     (Maybe.Nothing)))
    &(Datetime.strptime "Fri Mar 15 14:30:45 2024" "%c")
    "strptime %c parses locale datetime")

  (assert-equal test
    &(Result.Success
      (Datetime.init 2024
                     3
                     15
                     (Maybe.Just 14)
                     (Maybe.Just 30)
                     (Maybe.Just 45)
                     (Maybe.Nothing)
                     (Maybe.Nothing)))
    &(Datetime.strptime
      &(Datetime.strftime
        &(Datetime.init 2024
                        3
                        15
                        (Maybe.Just 14)
                        (Maybe.Just 30)
                        (Maybe.Just 45)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        "%c")
      "%c")
    "strptime %c roundtrips with strftime")

  (assert-true test
    (Result.error? &(Datetime.strptime "not-a-date" "%Y-%m-%d"))
    "strptime returns error on bad input")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024-03-15" "%Y/%m/%d"))
    "strptime returns error on format mismatch")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime
      &(Datetime.strftime &(Datetime.date 2024 3 15) "%Y-%m-%d")
      "%Y-%m-%d")
    "strptime roundtrips with strftime for date")
  (assert-equal test
    &(Result.Success
      (Datetime.init 2024
                     3
                     15
                     (Maybe.Just 14)
                     (Maybe.Just 30)
                     (Maybe.Just 45)
                     (Maybe.Nothing)
                     (Maybe.Nothing)))
    &(Datetime.strptime
      &(Datetime.strftime
        &(Datetime.init 2024
                        3
                        15
                        (Maybe.Just 14)
                        (Maybe.Just 30)
                        (Maybe.Just 45)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        "%Y-%m-%d %H:%M:%S")
      "%Y-%m-%d %H:%M:%S")
    "strptime roundtrips with strftime for datetime")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 4 9))
    &(Datetime.strptime "2024-100" "%Y-%j")
    "strptime rebuilds the date from %j")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 2 29))
    &(Datetime.strptime "2024-060" "%Y-%j")
    "strptime %j reaches the leap day")
  (assert-true test
    (Result.error? &(Datetime.strptime "2023-366" "%Y-%j"))
    "strptime rejects day 366 of a common year")
  (assert-true test
    (Result.error? &(Datetime.strptime "100" "%j"))
    "strptime rejects %j without a year")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024-03-15 100" "%Y-%m-%d %j")
    "strptime prefers an explicit calendar date over %j")

  (assert-equal test
    &(Result.Success (Datetime.date 2023 1 1))
    &(Datetime.strptime "2022-W52-7" "%G-W%V-%u")
    "strptime rebuilds 2023-01-01 from 2022-W52-7")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 12 30))
    &(Datetime.strptime "2025-W01-1" "%G-W%V-%u")
    "strptime rebuilds 2024-12-30 from 2025-W01-1")
  (assert-equal test
    &(Result.Success (Datetime.date 2021 1 3))
    &(Datetime.strptime "2020-W53-7" "%G-W%V-%u")
    "strptime reaches week 53 of a 53-week ISO year")
  (assert-true test
    (Result.error? &(Datetime.strptime "2021-W53-7" "%G-W%V-%u"))
    "strptime rejects week 53 of a 52-week ISO year")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024-W54-1" "%G-W%V-%u"))
    "strptime rejects %V outside 01-53")
  (assert-true test
    (Result.error? &(Datetime.strptime "W15-3" "W%V-%u"))
    "strptime rejects an ISO week date without %G")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024-W15" "%G-W%V"))
    "strptime rejects an ISO week date without a weekday")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024-8" "%Y-%u"))
    "strptime rejects %u outside 1-7")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024 11 4" "%Y %W %w")
    "strptime rebuilds the date from %W and %w")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 22))
    &(Datetime.strptime "2024 11 4" "%Y %U %w")
    "strptime rebuilds the date from %U and %w")
  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "2024 11 Friday" "%Y %W %A")
    "strptime takes the weekday for %W from %A")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024 11" "%Y %W"))
    "strptime rejects a week of the year without a weekday")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024 00 6" "%Y %U %w"))
    "strptime rejects a %U week and weekday falling outside the year")
  (assert-true test
    (Result.error? &(Datetime.strptime "2024-7" "%Y-%w"))
    "strptime rejects %w outside 0-6")

  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 6) "%d %b %Y"))
    "strptime rejects continuation bytes for a numeric field")
  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 20) "%Y-%m-%dT%H:%M:%S%z"))
    "strptime rejects continuation bytes across every numeric field")
  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 4) "%B"))
    "strptime rejects continuation bytes for %B")
  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 3) "%b"))
    "strptime rejects continuation bytes for %b")
  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 2) "%p"))
    "strptime rejects continuation bytes for %p")
  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 3) "%c"))
    "strptime rejects continuation bytes for a compound specifier")
  (assert-true test
    (Result.error? &(Datetime.strptime &(conts 6) "%j"))
    "strptime rejects continuation bytes for a ranged field")
  (assert-true test
    (Result.error? &(Datetime.strptime &(String.from-bytes &[226b 130b]) "%m"))
    "strptime rejects input truncated mid-character")
  (assert-true test
    (Result.error? &(Datetime.strptime "Jané" "%B"))
    "strptime rejects a month name running into a multibyte character")

  (assert-equal test
    &(Result.Success (Datetime.date 2024 3 15))
    &(Datetime.strptime "«2024-03-15»" "«%Y-%m-%d»")
    "strptime matches multibyte literals in the format")
  (assert-equal test
    &(Result.Success
      (Datetime.init 0
                     0
                     0
                     (Maybe.Nothing)
                     (Maybe.Nothing)
                     (Maybe.Nothing)
                     (Maybe.Nothing)
                     (Maybe.Just (Timezone.init @"UTC" 0l false))))
    &(Datetime.strptime "é UTC" "é %Z")
    "strptime reads %Z after a multibyte literal")
  (assert-equal test
    &(Result.Success
      (Datetime.init 0
                     0
                     0
                     (Maybe.Just 14)
                     (Maybe.Nothing)
                     (Maybe.Nothing)
                     (Maybe.Nothing)
                     (Maybe.Nothing)))
    &(Datetime.strptime "é02PM" "é%I%p")
    "strptime reads %p after a multibyte literal")
  (assert-equal test
    &(Result.Error
      (String.concat
        &[@"unknown format specifier: %" (String.from-bytes &[195b])]))
    &(Datetime.strptime "" "%é")
    "strptime reports an unknown specifier byte without re-encoding it")

  (assert-equal test
    &@""
    &(roundtrip-sweep SWEEP-FROM SWEEP-TO "%Y-%j")
    "every date in the sweep survives a %Y-%j roundtrip")
  (assert-equal test
    &@""
    &(roundtrip-sweep SWEEP-FROM SWEEP-TO "%G-W%V-%u")
    "every date in the sweep survives a %G-W%V-%u roundtrip")
  (assert-equal test
    &@""
    &(roundtrip-sweep SWEEP-FROM SWEEP-TO "%G-W%V-%a")
    "every date in the sweep survives a %G-W%V-%a roundtrip")
  (assert-equal test
    &@""
    &(roundtrip-sweep SWEEP-FROM SWEEP-TO "%Y %U %w")
    "every date in the sweep survives a %Y %U %w roundtrip")
  (assert-equal test
    &@""
    &(roundtrip-sweep SWEEP-FROM SWEEP-TO "%Y %W %w")
    "every date in the sweep survives a %Y %W %w roundtrip")
  (assert-equal test
    &@""
    &(roundtrip-sweep SWEEP-FROM SWEEP-TO "%Y %W %A")
    "every date in the sweep survives a %Y %W %A roundtrip")

  (assert-true test
    (= &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 15))
    "equal dates are equal")
  (assert-false test
    (= &(Datetime.date 2024 1 15) &(Datetime.date 2024 2 15))
    "different months are not equal")
  (assert-true test
    (> &(Datetime.date 2024 3 15) &(Datetime.date 2024 2 15))
    "greater-than with same year different month")
  (assert-true test
    (< &(Datetime.date 2023 12 31) &(Datetime.date 2024 1 1))
    "less-than with year priority over month")
  (assert-false test
    (> &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 15))
    "equal datetimes return false for >")
  (assert-false test
    (< &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 15))
    "equal datetimes return false for <")

  (assert-equal test
    &@"23:59:59"
    &(Datetime.isotime
      &(Datetime.add-seconds
        &(Datetime.init 2024
                        1
                        2
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        -1))
    "subtract 1 second from 00:00:00")
  (assert-equal test
    &@"22:58:59"
    &(Datetime.isotime
      &(Datetime.add-seconds
        &(Datetime.init 2024
                        1
                        2
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        -3661))
    "subtract 3661 seconds (1h1m1s) from 00:00:00")

  (assert-equal test
    0l
    (Datetime.diff &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 15))
    "diff: same date is 0")
  (assert-equal test
    86400l
    (Datetime.diff &(Datetime.date 2024 3 16) &(Datetime.date 2024 3 15))
    "diff: one day apart is 86400")
  (assert-equal test
    -86400l
    (Datetime.diff &(Datetime.date 2024 3 15) &(Datetime.date 2024 3 16))
    "diff: reversed order is negative")
  (assert-equal test
    3600l
    (Datetime.diff
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 1)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "diff: one hour apart is 3600")
  (assert-equal test
    90061l
    (Datetime.diff
      &(Datetime.init 2024
                      3
                      16
                      (Maybe.Just 1)
                      (Maybe.Just 1)
                      (Maybe.Just 1)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "diff: 1 day 1 hour 1 minute 1 second = 90061")
  (assert-equal test
    (* 365l 86400l)
    (Datetime.diff &(Datetime.date 2023 1 1) &(Datetime.date 2022 1 1))
    "diff: non-leap year is 365 days")
  (assert-equal test
    (* 366l 86400l)
    (Datetime.diff &(Datetime.date 2025 1 1) &(Datetime.date 2024 1 1))
    "diff: leap year 2024 has 366 days")
  (assert-equal test
    (* 36525l 86400l)
    (Datetime.diff &(Datetime.date 2100 1 1) &(Datetime.date 2000 1 1))
    "diff: a century of seconds does not wrap")
  (assert-equal test
    (* -36525l 86400l)
    (Datetime.diff &(Datetime.date 2000 1 1) &(Datetime.date 2100 1 1))
    "diff: a negative century of seconds does not wrap")

  (assert-equal test
    &(Datetime.date 2024 2 15)
    &(Datetime.add-months &(Datetime.date 2024 1 15) 1)
    "add-months: Jan to Feb")
  (assert-equal test
    &(Datetime.date 2024 2 29)
    &(Datetime.add-months &(Datetime.date 2024 1 31) 1)
    "add-months: Jan 31 to Feb 29 (leap year clamp)")
  (assert-equal test
    &(Datetime.date 2023 2 28)
    &(Datetime.add-months &(Datetime.date 2023 1 31) 1)
    "add-months: Jan 31 to Feb 28 (non-leap year clamp)")
  (assert-equal test
    &(Datetime.date 2024 4 30)
    &(Datetime.add-months &(Datetime.date 2024 3 31) 1)
    "add-months: Mar 31 to Apr 30 (30-day month clamp)")
  (assert-equal test
    &(Datetime.date 2025 1 15)
    &(Datetime.add-months &(Datetime.date 2024 12 15) 1)
    "add-months: Dec to Jan crosses year")
  (assert-equal test
    &(Datetime.date 2024 2 15)
    &(Datetime.add-months &(Datetime.date 2024 3 15) -1)
    "add-months: negative, Mar to Feb")
  (assert-equal test
    &(Datetime.date 2023 12 15)
    &(Datetime.add-months &(Datetime.date 2024 1 15) -1)
    "add-months: negative, Jan to Dec crosses year")
  (assert-equal test
    &(Datetime.date 2025 1 15)
    &(Datetime.add-months &(Datetime.date 2024 1 15) 12)
    "add-months: 12 months = 1 year")
  (assert-equal test
    &(Datetime.date 2022 1 15)
    &(Datetime.add-months &(Datetime.date 2024 1 15) -24)
    "add-months: -24 months = -2 years")
  (assert-equal test
    &(Datetime.date 2024 7 31)
    &(Datetime.add-months &(Datetime.date 2024 5 31) 2)
    "add-months: May 31 + 2 = Jul 31 (no clamp needed)")
  (assert-equal test
    &(Datetime.init 2024
                    2
                    15
                    (Maybe.Just 10)
                    (Maybe.Just 30)
                    (Maybe.Just 45)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.add-months
      &(Datetime.init 2024
                      1
                      15
                      (Maybe.Just 10)
                      (Maybe.Just 30)
                      (Maybe.Just 45)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      1)
    "add-months: preserves time components")

  (assert-equal test
    &(Datetime.date 2025 3 15)
    &(Datetime.add-years &(Datetime.date 2024 3 15) 1)
    "add-years: simple +1")
  (assert-equal test
    &(Datetime.date 2025 2 28)
    &(Datetime.add-years &(Datetime.date 2024 2 29) 1)
    "add-years: Feb 29 to non-leap year clamps to 28")
  (assert-equal test
    &(Datetime.date 2028 2 29)
    &(Datetime.add-years &(Datetime.date 2024 2 29) 4)
    "add-years: Feb 29 to next leap year stays 29")
  (assert-equal test
    &(Datetime.date 2023 3 15)
    &(Datetime.add-years &(Datetime.date 2024 3 15) -1)
    "add-years: negative, -1 year")
  (assert-equal test
    &(Datetime.date 2023 2 28)
    &(Datetime.add-years &(Datetime.date 2024 2 29) -1)
    "add-years: Feb 29 backward to non-leap clamps to 28")
  (assert-equal test
    &(Datetime.date 2024 7 15)
    &(Datetime.add-years &(Datetime.date 2024 7 15) 0)
    "add-years: +0 is identity")
  (assert-equal test
    &(Datetime.date 1900 2 28)
    &(Datetime.add-years &(Datetime.date 2000 2 29) -100)
    "add-years: 2000 Feb 29 -100 to 1900 (not leap) clamps to 28")
  (assert-equal test
    &(Datetime.date 2400 2 29)
    &(Datetime.add-years &(Datetime.date 2000 2 29) 400)
    "add-years: 2000 Feb 29 +400 to 2400 (leap) stays 29")
  (assert-equal test
    &(Datetime.init 2025
                    3
                    15
                    (Maybe.Just 14)
                    (Maybe.Just 30)
                    (Maybe.Just 0)
                    (Maybe.Nothing)
                    (Maybe.Nothing))
    &(Datetime.add-years
      &(Datetime.init 2024
                      3
                      15
                      (Maybe.Just 14)
                      (Maybe.Just 30)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      1)
    "add-years: preserves time components")

  (assert-equal test
    &(Duration.days 2)
    &(Duration.between &(Datetime.date 2024 1 3) &(Datetime.date 2024 1 1))
    "between: positive whole-day difference")
  (assert-equal test
    &(Duration.days -2)
    &(Duration.between &(Datetime.date 2024 1 1) &(Datetime.date 2024 1 3))
    "between: negative difference")
  (assert-true test
    (Duration.zero?
      &(Duration.between &(Datetime.date 2024 1 1) &(Datetime.date 2024 1 1)))
    "between: identical datetimes is zero")
  (assert-equal test
    &(Duration.seconds 3661)
    &(Duration.between
      &(Datetime.init 2024
                      1
                      1
                      (Maybe.Just 1)
                      (Maybe.Just 1)
                      (Maybe.Just 1)
                      (Maybe.Nothing)
                      (Maybe.Nothing))
      &(Datetime.init 2024
                      1
                      1
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Just 0)
                      (Maybe.Nothing)
                      (Maybe.Nothing)))
    "between: sub-day difference in seconds")

  (assert-equal test
    3600l
    (Duration.to-seconds &(Duration.hours 1))
    "to-seconds: exact")
  (assert-equal test
    1l
    (Duration.to-minutes &(Duration.seconds 90))
    "to-minutes: truncates positive remainder")
  (assert-equal test
    0l
    (Duration.to-minutes &(Duration.seconds 59))
    "to-minutes: below one minute is zero")
  (assert-equal test
    -1l
    (Duration.to-minutes &(Duration.seconds -90))
    "to-minutes: truncates toward zero for negatives")
  (assert-equal test
    1l
    (Duration.to-hours &(Duration.minutes 90))
    "to-hours: truncates remainder")
  (assert-equal test
    1l
    (Duration.to-days &(Duration.hours 25))
    "to-days: truncates remainder")
  (assert-equal test
    7l
    (Duration.to-days &(Duration.weeks 1))
    "to-days: one week is seven days")
  (assert-equal test
    (* 3551l 604800l)
    (Duration.to-seconds &(Duration.weeks 3551))
    "weeks: a count past the 32-bit second range does not wrap")
  (assert-equal test
    (* 24856l 86400l)
    (Duration.to-seconds &(Duration.days 24856))
    "days: a count past the 32-bit second range does not wrap")
  (assert-equal test
    (* 36525l 86400l)
    (Duration.to-seconds
      &(Duration.between &(Datetime.date 2100 1 1) &(Datetime.date 2000 1 1)))
    "between: a century does not wrap")
  (assert-equal test
    36525l
    (Duration.to-days
      &(Duration.between &(Datetime.date 2100 1 1) &(Datetime.date 2000 1 1)))
    "to-days: a century is 36525 days")

  (assert-equal test
    &(Duration.seconds 90)
    &(Duration.plus &(Duration.minutes 1) &(Duration.seconds 30))
    "plus: sums two deltas")
  (assert-equal test
    &(Duration.seconds 30)
    &(Duration.minus &(Duration.minutes 1) &(Duration.seconds 30))
    "minus: difference of two deltas")
  (assert-equal test
    &(Duration.seconds -30)
    &(Duration.minus &(Duration.seconds 30) &(Duration.minutes 1))
    "minus: can go negative")
  (assert-equal test
    &(Duration.seconds -60)
    &(Duration.negate &(Duration.minutes 1))
    "negate: flips a positive delta")
  (assert-equal test
    &(Duration.minutes 1)
    &(Duration.negate &(Duration.seconds -60))
    "negate: flips a negative delta")
  (assert-equal test
    &(Duration.minutes 3)
    &(Duration.scale &(Duration.minutes 1) 3)
    "scale: multiplies by a factor")
  (assert-equal test
    &(Duration.seconds 0)
    &(Duration.scale &(Duration.minutes 1) 0)
    "scale: by zero yields the zero delta")
  (assert-equal test
    &(Duration.minutes 3)
    &(Duration.mul &(Duration.minutes 1) 3)
    "mul: aliases scale")

  (assert-true test
    (Duration.= &(Duration.minutes 1) &(Duration.seconds 60))
    "=: equal durations from different units")
  (assert-false test
    (Duration.= &(Duration.days 49710) &(Duration.seconds -23296))
    "=: deltas that collide when truncated to 32 bits are not equal")
  (assert-false test
    (Duration.= &(Duration.minutes 1) &(Duration.seconds 61))
    "=: unequal durations")
  (assert-true test
    (Duration.< &(Duration.seconds 30) &(Duration.minutes 1))
    "<: shorter is less")
  (assert-false test
    (Duration.< &(Duration.minutes 1) &(Duration.seconds 30))
    "<: longer is not less")
  (assert-true test
    (Duration.> &(Duration.minutes 1) &(Duration.seconds 30))
    ">: longer is greater")
  (assert-false test
    (Duration.> &(Duration.seconds 30) &(Duration.minutes 1))
    ">: shorter is not greater")
  (assert-true test
    (Duration.> &(Duration.days 30000) &(Duration.days 1))
    ">: a delta past the 32-bit second range is still the longer one")
  (assert-false test
    (Duration.< &(Duration.days 30000) &(Duration.days 1))
    "<: a delta past the 32-bit second range is not the shorter one")
  (assert-true test
    (Duration.zero? &(Duration.seconds 0))
    "zero?: the zero delta")
  (assert-false test
    (Duration.zero? &(Duration.seconds 1))
    "zero?: a non-zero delta")
  (assert-false test
    (Duration.zero?
      &(Duration.plus &(Duration.days 49710) &(Duration.seconds 23296)))
    "zero?: a delta of exactly 2^32 seconds is not the zero delta")
  (assert-true test
    (Duration.pos? &(Duration.days 30000))
    "pos?: a delta past the 32-bit second range is positive")
  (assert-false test
    (Duration.neg? &(Duration.days 30000))
    "neg?: a delta past the 32-bit second range is not negative")
  (assert-true test (Duration.pos? &(Duration.seconds 1)) "pos?: positive delta")
  (assert-false test
    (Duration.pos? &(Duration.seconds -1))
    "pos?: negative delta is not positive")
  (assert-false test
    (Duration.pos? &(Duration.seconds 0))
    "pos?: zero is not positive")
  (assert-true test
    (Duration.neg? &(Duration.seconds -1))
    "neg?: negative delta")
  (assert-false test
    (Duration.neg? &(Duration.seconds 1))
    "neg?: positive delta is not negative")
  (assert-false test
    (Duration.neg? &(Duration.seconds 0))
    "neg?: zero is not negative")

  (assert-equal test
    &@"0s"
    &(Duration.str &(Duration.seconds 0))
    "str: zero delta")
  (assert-equal test
    &@"4s"
    &(Duration.str &(Duration.seconds 4))
    "str: single second")
  (assert-equal test
    &@"3m"
    &(Duration.str &(Duration.minutes 3))
    "str: single minute")
  (assert-equal test
    &@"2h"
    &(Duration.str &(Duration.hours 2))
    "str: single hour")
  (assert-equal test &@"1d" &(Duration.str &(Duration.days 1)) "str: single day")
  (assert-equal test
    &@"1d 2h 3m 4s"
    &(Duration.str &(Duration.seconds 93784))
    "str: multi-unit")
  (assert-equal test
    &@"1h 5s"
    &(Duration.str &(Duration.seconds 3605))
    "str: omits zero components")
  (assert-equal test
    &@"-30s"
    &(Duration.str &(Duration.seconds -30))
    "str: negative single unit")
  (assert-equal test
    &@"-1d 2h 3m 4s"
    &(Duration.str &(Duration.seconds -93784))
    "str: negative multi-unit")
  (assert-equal test
    &@"36525d 1h 1m 1s"
    &(Duration.str
      &(Duration.plus &(Duration.days 36525) &(Duration.seconds 3661)))
    "str: multi-decade delta")
  (assert-equal test
    &@"-36525d"
    &(Duration.str &(Duration.negate &(Duration.days 36525)))
    "str: negative multi-decade delta")

  (assert-equal test
    &@"2100-01-01"
    &(Datetime.isoformat
      &(Duration.add &(Datetime.date 2000 1 1) &(Duration.days 36525)))
    "add: a century-long delta lands on the right date")
  (assert-equal test
    &@"2000-01-01"
    &(Datetime.isoformat
      &(Duration.sub &(Datetime.date 2100 1 1) &(Duration.days 36525)))
    "sub: a century-long delta lands on the right date")
  (assert-equal test
    &@"2124-03-16 13:30:45"
    &(Datetime.strftime
      &(Duration.add
        &(Datetime.init 2024
                        3
                        15
                        (Maybe.Just 12)
                        (Maybe.Just 30)
                        (Maybe.Just 45)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        &(Duration.plus &(Duration.days 36525) &(Duration.hours 1)))
      "%Y-%m-%d %H:%M:%S")
    "add: a century-long delta keeps the time of day")

  (assert-equal test
    &@"0001-01-01"
    &(Datetime.isoformat
      &(Duration.sub &(Datetime.date 2024 1 1) &(Duration.days 739000)))
    "sub: a delta reaching before the first ordinal saturates")
  (assert-equal test
    &@"5879611-07-11"
    &(Datetime.isoformat
      &(Duration.add &(Datetime.date 2024 1 1) &(Duration.days 2147483647)))
    "add: a delta past the last ordinal saturates")
  (assert-equal test
    &@"5879611-07-11"
    &(Datetime.isoformat
      &(Duration.add
        &(Datetime.init 2024
                        1
                        1
                        (Maybe.Just 23)
                        (Maybe.Just 0)
                        (Maybe.Just 0)
                        (Maybe.Nothing)
                        (Maybe.Nothing))
        &(Duration.plus &(Duration.days 2147483647) &(Duration.hours 23))))
    "add: saturation leaves room for the time-of-day carry")

  (assert-equal test
    (* 36525l 86400l)
    (Duration.to-seconds &(Duration.from-seconds (* 36525l 86400l)))
    "from-seconds: holds a count wider than an Int")
  (assert-true test
    (Duration.=
      &(Duration.from-seconds (Duration.to-seconds &(Duration.days 36525)))
      &(Duration.days 36525))
    "from-seconds: round-trips to-seconds"))
