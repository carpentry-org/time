(relative-include "datetime.h")

(deftype Timezone [name String
                   delta Long
                   dst? Bool])
(derive Timezone =)
(derive Timezone zero)

(doc Timezone "A timezone representation.

- `name` is the timezone abbreviation (e.g. `\"UTC\"`, `\"EST\"`).
- `delta` is the offset from UTC in seconds (e.g. `-18000l` for UTC-5).
- `dst?` indicates whether daylight saving time is active.")
(defmodule Timezone
  (doc utc "The UTC timezone constant.")
  (def utc (init @"UTC" 0l false)))

(deftype Datetime
  [year Int
   month Int
   day Int
   hours (Maybe Int)
   minutes (Maybe Int)
   seconds (Maybe Int)
   nanoseconds (Maybe Int)
   tz (Maybe Timezone)])

(register-type TM
  [tm_sec Int
   tm_min Int
   tm_hour Int
   tm_mday Int
   tm_mon Int
   tm_year Int
   tm_wday Int
   tm_yday Int
   tm_isdst Int])

(defmodule TM
  (register tm_gmtoff (Fn [&TM] &Long))
  (register tm_zone (Fn [&TM] &String)))

(doc Datetime "This module is primarily concerned with date and time. The
`Datetime` type can be converted from and to various other types and formats,
formatted using `strftime`, and parsed using `strptime`. Both mimic
[the C formatting API](http://www.cplusplus.com/reference/ctime/strftime/).

Formatting example:

```
(load \"git@github.com:carpentry-org/time@0.5.3\")

(defn main []
  (println* &(Datetime.strftime &(Datetime.now) \"%Y-%m-%d %I:%M:%S.%n %p %z\")))
```

Parsing example:

```
(load \"git@github.com:carpentry-org/time@0.5.3\")

(defn main []
  (match (Datetime.strptime \"2024-03-15 14:30:00\" \"%Y-%m-%d %H:%M:%S\")
    (Result.Success dt) (println* &(Datetime.isoformat &dt))
    (Result.Error e) (println* &e)))
```")

(defmodule Datetime
  (doc copy "copies a `Datetime`. This will also copy the timezone contained in
it.")

  (private create-time)
  (hidden create-time)
  (register create-time (Fn [] (Ref TM)) "create_time")

  (private MONTH-STRINGS)
  (hidden MONTH-STRINGS)
  (def MONTH-STRINGS
    [@""
     @"January"
     @"February"
     @"March"
     @"April"
     @"May"
     @"June"
     @"July"
     @"August"
     @"September"
     @"October"
     @"November"
     @"December"])
  (private WEEKDAY-STRINGS)
  (hidden WEEKDAY-STRINGS)
  (def WEEKDAY-STRINGS
    [@""
     @"Monday"
     @"Tuesday"
     @"Wednesday"
     @"Thursday"
     @"Friday"
     @"Saturday"
     @"Sunday"])
  (private DAYS-IN-MONTH)
  (hidden DAYS-IN-MONTH)
  (def DAYS-IN-MONTH [0 31 28 31 30 31 30 31 31 30 31 30 31])
  (private DAYS-BEFORE-MONTH)
  (hidden DAYS-BEFORE-MONTH)
  (def DAYS-BEFORE-MONTH [0 0 31 59 90 120 151 181 212 243 273 304 334])
  (private SECOND)
  (hidden SECOND)
  (def SECOND 1)
  (private MINUTE)
  (hidden MINUTE)
  (def MINUTE (* 60 SECOND))
  (private HOUR)
  (hidden HOUR)
  (def HOUR (* 60 MINUTE))
  (private DAY)
  (hidden DAY)
  (def DAY (* 24 HOUR))

  (private is-leap)
  (hidden is-leap)
  (defn is-leap [y]
    (and (= 0 (mod y 4)) (or (/= 0 (mod y 100)) (= 0 (mod y 400)))))
  (private days-before-year)
  (hidden days-before-year)
  (defn days-before-year [year]
    (let [y (Int.dec year)] (- (+ (* y 365) (+ (/ y 4) (/ y 400))) (/ y 100))))

  (private DI400Y)
  (hidden DI400Y)
  (def DI400Y (days-before-year 401))
  (private DI100Y)
  (hidden DI100Y)
  (def DI100Y (days-before-year 101))
  (private DI4Y)
  (hidden DI4Y)
  (def DI4Y (days-before-year 5))

  (private days-before-month)
  (hidden days-before-month)
  (defn days-before-month [year month]
    (if (and (> month 2) (is-leap year))
      (Int.inc @(Array.unsafe-nth &DAYS-BEFORE-MONTH month))
      @(Array.unsafe-nth &DAYS-BEFORE-MONTH month)))

  (private days-in-month)
  (hidden days-in-month)
  (defn days-in-month [year month]
    (if (and (= month 2) (is-leap year))
      29
      @(Array.unsafe-nth &DAYS-IN-MONTH month)))

  (private ymd2ord)
  (hidden ymd2ord)
  (defn ymd2ord [year month day]
    (+ (+ (days-before-year year) (days-before-month year month)) day))

  (doc date "create a `Datetime` from a year `y`, month `m`, and day `d`.")
  (defn date [y m d]
    (init y
          m
          d
          (Maybe.Nothing)
          (Maybe.Nothing)
          (Maybe.Nothing)
          (Maybe.Nothing)
          (Maybe.Nothing)))

  (doc to-ordinal "converts a `Datetime` struct `dt` to a Gregorian ordinal.")
  (defn to-ordinal [dt] (ymd2ord @(year dt) @(month dt) @(day dt)))

  (doc from-ordinal "converts a Gregorian ordinal `ord` to a `Datetime`.")
  (defn from-ordinal [ord]
    (let [ord (- ord 1)
          n400 (/ ord DI400Y)
          ord- (mod ord DI400Y)
          year- (+ (* n400 400) 1)
          n100 (/ ord- DI100Y)
          ord-- (mod ord- DI100Y)
          n4 (/ ord-- DI4Y)
          ord--- (mod ord-- DI4Y)
          n1 (/ ord--- 365)
          n (mod ord--- 365)
          year (+ year- (+ (* n100 100) (+ (* n4 4) n1)))]
      (if (or (= n1 4) (= n100 4))
        (date (- year 1) 12 31)
        (let [month (Int.bit-shift-right (+ n 50) 5)
              prec (days-before-month year month)]
          (if (> prec n)
            (let [month (- month 1)
                  prec (- prec (days-in-month year month))]
              (date year month (+ (- n prec) 1)))
            (date year month (+ (- n prec) 1)))))))

  (doc weekday
    "returns the weekday of the `Datetime` `dt` as a number in the range of `0` to `6`.")
  (defn weekday [dt] (mod (+ (to-ordinal dt) 6) 7))

  (doc isoweekday "returns the ISO representation of weekday of the `Datetime`
`dt` as a number in the range of `1` to `7`.")
  (defn isoweekday [dt] (+ (weekday dt) 1))

  (doc yearday "returns the day of the year of the `Datetime` `dt` as a number
in the range of `1` to `365` or `366`, depending on whether it’s a leap year.")
  (defn yearday [dt] (+ (days-before-month @(year dt) @(month dt)) @(day dt)))

  (doc weekday-string "returns the name of the weekday of the `Datetime` `dt`.")
  (defn weekday-string [dt]
    (let [modord (mod (to-ordinal dt) 7)]
      @(Array.unsafe-nth &WEEKDAY-STRINGS (if (= modord 0) 7 modord))))

  (doc weekday-short-string "returns the abbreviated name of the weekday of the
`Datetime` `dt`.")
  (defn weekday-short-string [dt]
    (let [modord (mod (to-ordinal dt) 7)]
      (String.prefix
        (Array.unsafe-nth &WEEKDAY-STRINGS (if (= modord 0) 7 modord))
        3)))

  (doc month-string "returns the name of the month of the `Datetime` `dt`.")
  (defn month-string [dt] @(Array.unsafe-nth &MONTH-STRINGS @(month dt)))

  (doc month-short-string "returns the abbreviated name of the month of the
`Datetime` `dt`.")
  (defn month-short-string [dt]
    (String.prefix (Array.unsafe-nth &MONTH-STRINGS @(month dt)) 3))

  (doc leap? "checks whether the `Datetime` `dt` is a leap year.")
  (defn leap? [dt] (is-leap @(year dt)))

  ; floor division (matches Python's //)
  (hidden div-)
  (defn div- [a n] (to-int (floor (/ (Double.from-int a) (Double.from-int n)))))

  ; modulo paired with floor division (Python-style, sign follows divisor)
  (hidden mod-)
  (defn mod- [a n] (- a (* n (div- a n))))

  (private iso-week1-monday)
  (hidden iso-week1-monday)
  ; the Gregorian ordinal of the Monday starting ISO week 1 of year `y` (the week
  ; holding that year's first Thursday). firstwd is 0=Mon..6=Sun, matching weekday.
  (defn iso-week1-monday [y]
    (let [jan1 (ymd2ord y 1 1)
          firstwd (mod (+ jan1 6) 7)]
      (if (> firstwd 3) (- (+ jan1 7) firstwd) (- jan1 firstwd))))

  (doc isocalendar "returns the ISO 8601 week date of the `Datetime` `dt` as a
three-element array `[iso-year iso-week iso-weekday]`. `iso-week` runs from `1` to
`53` and `iso-weekday` from `1` (Monday) to `7` (Sunday). The ISO year can differ
from the calendar year near a year boundary: `2023-01-01` is week `52` of `2022`,
and `2024-12-30` is week `01` of `2025`.")
  (defn isocalendar [dt]
    (let-do [ord (to-ordinal dt)
             y @(year dt)
             week (div- (- ord (iso-week1-monday y)) 7)]
      (if (< week 0)
        (do
          (set! y (Int.dec y))
          (set! week (div- (- ord (iso-week1-monday y)) 7)))
        (when-do (and (> week 51) (>= ord (iso-week1-monday (Int.inc y))))
          (set! y (Int.inc y))
          (set! week 0)))
      [y (Int.inc week) (isoweekday dt)]))

  (private long-iso-year?)
  (hidden long-iso-year?)
  ; a 53-week ISO year spans 371 days from one week-1 Monday to the next
  (defn long-iso-year? [y]
    (= 371 (- (iso-week1-monday (Int.inc y)) (iso-week1-monday y))))

  (private date-from-yearday)
  (hidden date-from-yearday)
  (defn date-from-yearday [y j]
    (cond
      (< y 1) (Result.Error @"%j needs a year of 1 or later")
      (> j (if (is-leap y) 366 365))
        (Result.Error
          (String.concat
            &[@"%j out of range for " (Int.str y) @": " (Int.str j)]))
      (Result.Success (from-ordinal (+ (Int.dec (ymd2ord y 1 1)) j)))))

  (private date-from-isoweek)
  (hidden date-from-isoweek)
  ; `wd` is Monday-based, as in `weekday`
  (defn date-from-isoweek [y w wd]
    (cond
      (< y 1) (Result.Error @"%G needs a year of 1 or later")
      (and (= w 53) (not (long-iso-year? y)))
        (Result.Error
          (String.concat
            &[@"%V out of range: ISO year " (Int.str y) @" has 52 weeks"]))
      (Result.Success
        (from-ordinal (+ (iso-week1-monday y) (+ (* (Int.dec w) 7) wd))))))

  (private date-from-week)
  (hidden date-from-week)
  ; week 0 holds the days before the year’s first Monday (%W) or Sunday (%U)
  (defn date-from-week [y w wd monday?]
    (let [jan1 (ymd2ord y 1 1)
          start (+ jan1 (mod (- 7 (mod (+ jan1 (if monday? 6 0)) 7)) 7))
          ord (+ start
                 (+ (* (Int.dec w) 7) (if monday? wd (mod (Int.inc wd) 7))))
          spec (if monday? @"%W" @"%U")]
      (cond
        (< y 1)
          (Result.Error (String.concat &[spec @" needs a year of 1 or later"]))
        (or (< ord jan1) (> ord (ymd2ord y 12 31)))
          (Result.Error
            (String.concat &[spec @" and weekday fall outside " (Int.str y)]))
        (Result.Success (from-ordinal ord)))))

  (doc add-seconds "adds a number of seconds `n` to a `Datetime`.

If `n` is negative, it will be subtracted instead.")
  (defn add-seconds [d n]
    (if (neg? n)
      (let-do [nd @d
               s (Maybe.from @(seconds d) 0)
               a (+ s n)]
        (set-seconds! &nd (Maybe.Just (mod- a 60)))
        (if (>= a 0)
          nd
          (let-do [m (div- a 60)
                   dm (Maybe.from @(minutes d) 0)
                   ma (+ m dm)]
            (set-minutes! &nd (Maybe.Just (mod- ma 60)))
            (if (>= ma 0)
              nd
              (let-do [h (div- ma 60)
                       dh (Maybe.from @(hours d) 0)
                       ha (+ h dh)]
                (set-hours! &nd (Maybe.Just (mod- ha 24)))
                (if (>= ha 0)
                  nd
                  (let-do [ord (to-ordinal d)
                           nnd (from-ordinal (+ ord (div- ha 24)))]
                    (set-day! &nd @(day &nnd))
                    (set-month! &nd @(month &nnd))
                    (set-year! &nd @(year &nnd))
                    nd)))))))
      (let-do [nd @d
               days (/ n DAY)
               s (Maybe.from @(seconds d) 0)
               a (+ s (Int.mod n DAY))]
        (set-seconds! &nd (Maybe.Just (Int.mod a 60)))
        (if (and (< a 60) (= days 0))
          nd
          (let-do [m (/ a 60)
                   dm (Maybe.from @(minutes d) 0)
                   ma (+ m dm)]
            (set-minutes! &nd (Maybe.Just (Int.mod ma 60)))
            (if (and (< ma 60) (= days 0))
              nd
              (let-do [h (/ ma 60)
                       dh (Maybe.from @(hours d) 0)
                       ha (+ h dh)]
                (set-hours! &nd (Maybe.Just (Int.mod ha 24)))
                (if (and (< ha 24) (= days 0))
                  nd
                  (let-do [ord (to-ordinal d)
                           nnd (from-ordinal (+ ord (+ days (/ ha 24))))]
                    (set-day! &nd @(day &nnd))
                    (set-month! &nd @(month &nnd))
                    (set-year! &nd @(year &nnd))
                    nd)))))))))

  (private EPOCH-ORDINAL)
  (hidden EPOCH-ORDINAL)
  ; the Gregorian ordinal of the Unix epoch, 1970-01-01
  (def EPOCH-ORDINAL (ymd2ord 1970 1 1))

  (doc to-unix-timestamp "returns the representation of the `Datetime` `dt` as
a UNIX timestamp, i.e. the number of seconds elapsed since the 1st of January,
1970.")
  (defn to-unix-timestamp [dt]
    (let [tz (Maybe.from @(tz dt) (Timezone.zero))
          days (- (to-ordinal dt) EPOCH-ORDINAL)
          hh (Maybe.from @(hours dt) 0)
          mm (Maybe.from @(minutes dt) 0)
          ss (Maybe.from @(seconds dt) 0)]
      (-
        (+
          (* (Long.from-int days) (Long.from-int DAY))
          (Long.from-int (+ (* hh HOUR) (+ (* mm MINUTE) ss))))
        @(Timezone.delta &tz))))

  (doc from-unix-timestamp "returns the `Datetime` equivalent to the UNIX
timestamp `ts`, i.e. the number of seconds elapsed since the 1st of January,
1970.")
  (defn from-unix-timestamp [ts]
    (let-do [day-secs (Long.from-int DAY)
             days (Long.to-int (/ ts day-secs))
             secs (Long.to-int (- ts (* (Long.from-int days) day-secs)))]
      ; / and mod truncate toward zero, so a negative ts can leave secs
      ; negative; borrow a day so the time-of-day stays in 0..86399
      (when-do (< secs 0) (set! days (Int.dec days)) (set! secs (+ secs DAY)))
      (let [d (from-ordinal (+ EPOCH-ORDINAL days))]
        (init @(year &d)
              @(month &d)
              @(day &d)
              (Maybe.Just (/ secs HOUR))
              (Maybe.Just (/ (mod secs HOUR) MINUTE))
              (Maybe.Just (mod secs MINUTE))
              (Maybe.Nothing)
              (Maybe.Nothing)))))

  (doc utc? "checks whether the timezone of the `Datetime` `dt` is UTC. The
timezone name comparison is case-insensitive. It will also return true if the
timezone is not set.")
  (defn utc? [dt]
    (or (Maybe.nothing? (tz dt))
        (let [t (Maybe.from @(tz dt) (Timezone.zero))]
          (and
            (= &(String.ascii-to-lower (Timezone.name &t)) "utc")
            (and (= @(Timezone.delta &t) 0l) (not @(Timezone.dst? &t)))))))

  (doc to-utc "returns the `Datetime` `dt` expressed in UTC.

The wall-clock fields are shifted by the timezone offset (`delta`) so they name
the same instant in UTC, and the timezone is set to `Timezone.utc`. A `Datetime`
that is already UTC — or that has no timezone, which the library treats as UTC
(see [`utc?`](#utc?)) — keeps its fields and is simply labelled UTC.")
  (defn to-utc [dt]
    (if (utc? dt)
      (let-do [nd @dt] (set-tz! &nd (Maybe.Just @&Timezone.utc)) nd)
      (let-do [delta (Long.to-int
                 @(Timezone.delta &(Maybe.from @(tz dt) (Timezone.zero))))
               nd (add-seconds dt (- 0 delta))]
        (set-tz! &nd (Maybe.Just @&Timezone.utc))
        nd)))

  (doc in-timezone "returns the `Datetime` `dt` expressed in the timezone
`target`, preserving the instant: the wall-clock fields are shifted so they name
the same moment measured in `target`, and the timezone is set to `target`.

```
(let [dt (Datetime.init 2024 1 1 (Maybe.Just 22) (Maybe.Just 0) (Maybe.Just 0)
                        (Maybe.Nothing) (Maybe.Just (Timezone.init @\"EST\" -18000l false)))]
  (Datetime.isotime &(Datetime.in-timezone &dt &Timezone.utc))) ; => \"03:00:00\"
```")
  (defn in-timezone [dt target]
    (let-do [u (to-utc dt)
             secs (Long.to-int @(Timezone.delta target))
             nd (add-seconds &u secs)]
      (set-tz! &nd (Maybe.Just @target))
      nd))

  (doc isoformat "returns the ISO format for the `Datetime` `dt`.

The ISO format is of the form `YYYY-MM-DD`. The time value is not represented.")
  (defn isoformat [dt] (fmt "%04d-%02d-%02d" @(year dt) @(month dt) @(day dt)))

  (doc isotime "returns the ISO time format for the `Datetime` `dt`.

The ISO format is of the form `HH:MM:SS`. The date value is not represented.")
  (defn isotime [dt]
    (fmt "%02d:%02d:%02d"
         (Maybe.from @(hours dt) 0)
         (Maybe.from @(minutes dt) 0)
         (Maybe.from @(seconds dt) 0)))

  (doc subsecond-nanos "returns the sub-second part of the nanosecond count `t`,
that is, `t` modulo one billion.

The reduction is exact over the whole `Uint64` range, including counts wider
than a C `long`.")
  (defn subsecond-nanos [t]
    (let [billion (Uint64.from-long 1000000000l)]
      (Long.to-int (Uint64.to-long (- t (* (/ t billion) billion))))))

  (doc now "returns the `Datetime` representing the current time.

All of the time information is obtained from the operating system directly.")
  (defn now []
    (let [t (System.nanotime)
          ct (create-time)]
      (init (+ @(TM.tm_year ct) 1900)
            (Int.inc @(TM.tm_mon ct))
            @(TM.tm_mday ct)
            (Maybe.Just @(TM.tm_hour ct))
            (Maybe.Just @(TM.tm_min ct))
            (Maybe.Just @(TM.tm_sec ct))
            (Maybe.Just (subsecond-nanos t))
            (Maybe.Just
              (Timezone.init @(TM.tm_zone ct)
                             @(TM.tm_gmtoff ct)
                             (/= 0 @(TM.tm_isdst ct)))))))

  (register format (Fn [(Ref String) (Ref Datetime)] String))
  (implements format Datetime.format)

  (register format-for (Fn [Char (Ref Datetime)] String))

  (doc strftime "formats the `Datetime` `dt` according to the string provided
in `s`. The formatting options mimic [the C interface](http://www.cplusplus.com/reference/ctime/strftime/).

Text outside a directive is copied verbatim. `%%` renders a single `%`, as does
a trailing `%` with nothing after it; an unrecognized specifier renders as the
character that follows the `%`.

You can alternatively use the `fmt` macro or `format` function, but you’ll only
be able to use one of the formatting properties there. Thus this function is
provided as a convenience for fine-grained string tweaking.

Example:

```
&(Datetime.strftime &(Datetime.now) \"%Y-%m-%d %I:%M:%S.%n %p %z\")
```")
  (defn strftime [dt s]
    (let-do [result @""
             len (String.length s)
             i 0
             lit 0]
      (while (< i len)
        (if (= \% (String.char-at s i))
          (do
            (when (< lit i)
              (set! result (String.concat &[result (String.byte-slice s lit i)])))
            (if (< (Int.inc i) len)
              (let-do [spec (String.char-at s (Int.inc i))]
                (set! result
                      (String.concat
                        &[result (if (= \% spec) @"%" (format-for spec dt))]))
                (set! i (+ i 2)))
              (do
                (set! result (String.concat &[result @"%"]))
                (set! i (Int.inc i))))
            (set! lit i))
          (set! i (Int.inc i))))
      (when (< lit len)
        (set! result (String.concat &[result (String.byte-slice s lit len)])))
      result))

  (private format-for)
  (hidden format-for)
  (defn format-for [c dt]
    (case c
          \a
          (weekday-short-string dt)
          \A
          (weekday-string dt)
          \w
          (str (weekday dt))
          \d
          (format "%02d" @(day dt))
          \b
          (month-short-string dt)
          \B
          (month-string dt)
          \m
          (format "%02d" @(month dt))
          \y
          (format "%02d" (mod @(year dt) 100))
          \Y
          (format "%04d" @(year dt))
          \H
          (format "%02d" (Maybe.from @(hours dt) 0))
          \I
          (let [h (mod (Maybe.from @(hours dt) 0) 12)]
            (format "%02d" (if (= h 0) 12 h)))
          \p
          (if (> (Maybe.from @(hours dt) 0) 11) @"PM" @"AM")
          \M
          (format "%02d" (Maybe.from @(minutes dt) 0))
          \S
          (format "%02d" (Maybe.from @(seconds dt) 0))
          \n
          (format "%09d" (Maybe.from @(nanoseconds dt) 0))
          \z
          (match @(tz dt)
            (Maybe.Just t)
              (let [d @(Timezone.delta &t)
                    s (* 60l 60l)]
                (fmt "%s%02d%02d"
                     (if (< d 0l) "-" "+")
                     (Long.abs (/ d s))
                     (/ (Long.abs (mod d s)) 60l)))
            (Maybe.Nothing) @"")
          \Z
          @(Timezone.name &(Maybe.from @(tz dt) (Timezone.zero)))
          \j
          (format "%03d" (yearday dt))
          \U
          ; week of the year, Sunday as the first day; days before the first
          ; Sunday are week 0. weekday is Monday-based, so shift to Sunday-based.
          (format "%02d" (/ (+ (- (yearday dt) (mod (+ (weekday dt) 1) 7)) 6) 7))
          \W
          ; week of the year, Monday as the first day; days before the first
          ; Monday are week 0. weekday is already Monday-based.
          (format "%02d" (/ (+ (- (yearday dt) (weekday dt)) 6) 7))
          \c
          (strftime dt "%a %b %d %H:%M:%S %Y")
          \x
          (isoformat dt)
          \X
          (isotime dt)
          \u
          (str (isoweekday dt))
          \V
          (let [ic (isocalendar dt)] (format "%02d" @(Array.unsafe-nth &ic 1)))
          \G
          (let [ic (isocalendar dt)] (format "%04d" @(Array.unsafe-nth &ic 0)))
          \F
          (strftime dt "%Y-%m-%d")
          \T
          (strftime dt "%H:%M:%S")
          \R
          (strftime dt "%H:%M")
          \D
          (strftime dt "%m/%d/%y")
          \r
          (strftime dt "%I:%M:%S %p")
          \h
          (month-short-string dt)
          (String.from-bytes &[(Byte.from-int (Char.to-int c))])))

  (doc format "The interface implementation of `format` for `Datetime` values.

It mimics [the C interface](http://www.cplusplus.com/reference/ctime/strftime/).")
  (defn format [s dt]
    (let [idx (String.index-of s \%)
          len (String.length s)]
      (if (or (< idx 0) (= idx (Int.dec len)))
        @s
        (String.concat
          &[(String.byte-slice s 0 idx)
            (format-for (String.char-at s (Int.inc idx)) dt)
            (String.byte-slice s (+ idx 2) len)]))))

  (private parse-digits)
  (hidden parse-digits)
  (defn parse-digits [s pos n]
    (if (<= (+ pos n) (String.length s))
      (Int.from-string &(String.byte-slice s pos (+ pos n)))
      (Maybe.Nothing)))

  (private parse-ranged)
  (hidden parse-ranged)
  (defn parse-ranged [s pos n lo hi]
    (match (parse-digits s pos n)
      (Maybe.Just v)
        (if (and (>= v lo) (<= v hi)) (Maybe.Just v) (Maybe.Nothing))
      (Maybe.Nothing) (Maybe.Nothing)))

  (private match-in-array)
  (hidden match-in-array)
  (defn match-in-array [arr s pos]
    (let-do [result -1
             i 1
             slen (String.length s)]
      (while (and (= result -1) (< i (Array.length arr)))
        (let [candidate (Array.unsafe-nth arr i)
              clen (String.length candidate)]
          (if (and (<= (+ pos clen) slen)
                   (= &(String.byte-slice s pos (+ pos clen)) candidate))
            (set! result i)
            (set! i (+ i 1)))))
      result))

  (private match-short-in-array)
  (hidden match-short-in-array)
  (defn match-short-in-array [arr s pos]
    (if (> (+ pos 3) (String.length s))
      -1
      (let-do [result -1
               i 1
               tok (String.byte-slice s pos (+ pos 3))]
        (while (and (= result -1) (< i (Array.length arr)))
          (let [candidate (Array.unsafe-nth arr i)]
            (if (and (>= (String.length candidate) 3)
                     (= &tok &(String.byte-slice candidate 0 3)))
              (set! result i)
              (set! i (+ i 1)))))
        result)))

  (private expand-compound-formats)
  (hidden expand-compound-formats)
  (defn expand-compound-formats [fmt]
    (let-do [result @""
             i 0
             len (String.length fmt)]
      (while (< i len)
        (let [c (String.char-at fmt i)]
          (if (and (= c \%) (< (+ i 1) len))
            (let [spec (String.char-at fmt (+ i 1))]
              (case spec
                    \c
                    (do
                      (set! result
                            (String.concat &[result @"%a %b %d %H:%M:%S %Y"]))
                      (set! i (+ i 2)))
                    \x
                    (do
                      (set! result (String.concat &[result @"%Y-%m-%d"]))
                      (set! i (+ i 2)))
                    \X
                    (do
                      (set! result (String.concat &[result @"%H:%M:%S"]))
                      (set! i (+ i 2)))
                    \F
                    (do
                      (set! result (String.concat &[result @"%Y-%m-%d"]))
                      (set! i (+ i 2)))
                    \T
                    (do
                      (set! result (String.concat &[result @"%H:%M:%S"]))
                      (set! i (+ i 2)))
                    \R
                    (do
                      (set! result (String.concat &[result @"%H:%M"]))
                      (set! i (+ i 2)))
                    \D
                    (do
                      (set! result (String.concat &[result @"%m/%d/%y"]))
                      (set! i (+ i 2)))
                    \r
                    (do
                      (set! result (String.concat &[result @"%I:%M:%S %p"]))
                      (set! i (+ i 2)))
                    \h
                    (do
                      (set! result (String.concat &[result @"%b"]))
                      (set! i (+ i 2)))
                    (do
                      (set! result
                            (String.concat
                              &[result (String.byte-slice fmt i (+ i 2))]))
                      (set! i (+ i 2)))))
            (do
              (set! result
                    (String.concat &[result (String.byte-slice fmt i (+ i 1))]))
              (set! i (+ i 1))))))
      result))

  (doc strptime "parses a string `input` according to format string `fmt`,
returning a `(Result Datetime String)`.

The format specifiers mirror those of `strftime`:

- `%Y` — 4-digit year
- `%y` — 2-digit year (00–68 → 2000–2068, 69–99 → 1969–1999)
- `%m` — 2-digit month (01–12)
- `%b` — abbreviated month name (Jan, Feb, ...)
- `%B` — full month name (January, February, ...)
- `%d` — 2-digit day (01–31)
- `%H` — 2-digit hour, 24h (00–23)
- `%I` — 2-digit hour, 12h (01–12)
- `%p` — AM or PM
- `%M` — 2-digit minute (00–59)
- `%S` — 2-digit second (00–59)
- `%n` — 9-digit nanoseconds
- `%z` — timezone offset (+HHMM or -HHMM)
- `%Z` — timezone name (alphabetic characters)
- `%a` — abbreviated weekday name (Mon, Tue, ...)
- `%A` — full weekday name (Monday, Tuesday, ...)
- `%w` — weekday number, Monday first (0–6), as `strftime` writes it
- `%u` — ISO weekday, Monday first (1–7)
- `%j` — day of year (001–366)
- `%U` — week of year, Sunday first (00–53)
- `%W` — week of year, Monday first (00–53)
- `%V` — ISO week number (01–53)
- `%G` — ISO week-based year
- `%c` — locale datetime (expands to `%a %b %d %H:%M:%S %Y`)
- `%x` — ISO date (expands to `%Y-%m-%d`)
- `%X` — ISO time (expands to `%H:%M:%S`)
- `%F` — ISO date (expands to `%Y-%m-%d`)
- `%T` — 24-hour time (expands to `%H:%M:%S`)
- `%R` — 24-hour time without seconds (expands to `%H:%M`)
- `%D` — US-style date (expands to `%m/%d/%y`)
- `%r` — 12-hour clock time (expands to `%I:%M:%S %p`)
- `%h` — abbreviated month name (alias of `%b`)

An explicit calendar date wins: if the format supplies both a month (`%m`, `%b`
or `%B`) and a day (`%d`), the date comes from those, and the week and
day-of-year fields are only range-checked. Otherwise the date is reconstructed
from the first complete set of

1. a year (`%Y`/`%y`) and `%j`,
2. `%G`, `%V` and a weekday (`%u`, `%w`, `%a` or `%A`),
3. a year, `%U` or `%W`, and a weekday.

An incomplete set is an error rather than a silently wrong date, as is a value
impossible for its year: `%j` past the end of the year, `%V` of `53` in a
52-week ISO year, or a `%U`/`%W` week and weekday landing outside the year. A
weekday on its own carries no date and is ignored.

Example:
```
(Datetime.strptime \"2024-03-15 14:30:00\" \"%Y-%m-%d %H:%M:%S\")
```")
  (defn strptime [input fmt]
    (let-do [efmt (expand-compound-formats fmt)
             ipos 0
             fpos 0
             flen (String.length &efmt)
             ilen (String.length input)
             yr 0
             has-year false
             mo 0
             dy 0
             jd 0
             iso-y 0
             iso-w 0
             wk -1
             wk-monday? false
             wd -1
             hr -1
             mi -1
             sc -1
             ns -1
             ampm 0
             tz-nm @""
             tz-delta 0l
             has-tz false
             err @""
             ok true]
      (while (and ok (< fpos flen))
        (let [fc (String.char-at &efmt fpos)]
          (cond
            (and (= fc \%) (< (+ fpos 1) flen))
              (let [spec (String.char-at &efmt (+ fpos 1))]
                (case spec
                      \Y
                      (match (parse-digits input ipos 4)
                        (Maybe.Just v)
                          (do
                            (set! yr v)
                            (set! has-year true)
                            (set! ipos (+ ipos 4))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %Y") (set! ok false)))
                      \y
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! yr (if (< v 69) (+ v 2000) (+ v 1900)))
                            (set! has-year true)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %y") (set! ok false)))
                      \m
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! mo v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %m") (set! ok false)))
                      \d
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! dy v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %d") (set! ok false)))
                      \H
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! hr v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %H") (set! ok false)))
                      \I
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! hr v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %I") (set! ok false)))
                      \p
                      (if (> (+ ipos 2) ilen)
                        (do (set! err @"failed to parse %p") (set! ok false))
                        (let [tok (String.byte-slice input ipos (+ ipos 2))]
                          (cond
                            (= &tok "AM")
                              (do
                                (set! ampm 1)
                                (set! ipos (+ ipos 2))
                                (set! fpos (+ fpos 2)))
                            (= &tok "PM")
                              (do
                                (set! ampm 2)
                                (set! ipos (+ ipos 2))
                                (set! fpos (+ fpos 2)))
                            (do
                              (set! err @"failed to parse %p: expected AM or PM")
                              (set! ok false)))))
                      \M
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! mi v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %M") (set! ok false)))
                      \S
                      (match (parse-digits input ipos 2)
                        (Maybe.Just v)
                          (do
                            (set! sc v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %S") (set! ok false)))
                      \n
                      (match (parse-digits input ipos 9)
                        (Maybe.Just v)
                          (do
                            (set! ns v)
                            (set! ipos (+ ipos 9))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %n") (set! ok false)))
                      \b
                      (let [idx (match-short-in-array &MONTH-STRINGS input ipos)]
                        (if (> idx 0)
                          (do
                            (set! mo idx)
                            (set! ipos (+ ipos 3))
                            (set! fpos (+ fpos 2)))
                          (do (set! err @"failed to parse %b") (set! ok false))))
                      \B
                      (let [idx (match-in-array &MONTH-STRINGS input ipos)]
                        (if (> idx 0)
                          (do
                            (set! mo idx)
                            (set! ipos
                                  (+ ipos
                                     (String.length (Array.unsafe-nth &MONTH-STRINGS
                                                                      idx))))
                            (set! fpos (+ fpos 2)))
                          (do (set! err @"failed to parse %B") (set! ok false))))
                      \a
                      (let [idx (match-short-in-array &WEEKDAY-STRINGS
                                                      input
                                                      ipos)]
                        (if (> idx 0)
                          (do
                            (set! wd (Int.dec idx))
                            (set! ipos (+ ipos 3))
                            (set! fpos (+ fpos 2)))
                          (do (set! err @"failed to parse %a") (set! ok false))))
                      \A
                      (let [idx (match-in-array &WEEKDAY-STRINGS input ipos)]
                        (if (> idx 0)
                          (do
                            (set! wd (Int.dec idx))
                            (set! ipos
                                  (+ ipos
                                     (String.length (Array.unsafe-nth &WEEKDAY-STRINGS
                                                                      idx))))
                            (set! fpos (+ fpos 2)))
                          (do (set! err @"failed to parse %A") (set! ok false))))
                      \w
                      (match (parse-ranged input ipos 1 0 6)
                        (Maybe.Just v)
                          (do
                            (set! wd v)
                            (set! ipos (+ ipos 1))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do
                            (set! err @"failed to parse %w: expected 0-6")
                            (set! ok false)))
                      \j
                      (match (parse-ranged input ipos 3 1 366)
                        (Maybe.Just v)
                          (do
                            (set! jd v)
                            (set! ipos (+ ipos 3))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do
                            (set! err @"failed to parse %j: expected 001-366")
                            (set! ok false)))
                      \U
                      (match (parse-ranged input ipos 2 0 53)
                        (Maybe.Just v)
                          (do
                            (set! wk v)
                            (set! wk-monday? false)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do
                            (set! err @"failed to parse %U: expected 00-53")
                            (set! ok false)))
                      \W
                      (match (parse-ranged input ipos 2 0 53)
                        (Maybe.Just v)
                          (do
                            (set! wk v)
                            (set! wk-monday? true)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do
                            (set! err @"failed to parse %W: expected 00-53")
                            (set! ok false)))
                      \V
                      (match (parse-ranged input ipos 2 1 53)
                        (Maybe.Just v)
                          (do
                            (set! iso-w v)
                            (set! ipos (+ ipos 2))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do
                            (set! err @"failed to parse %V: expected 01-53")
                            (set! ok false)))
                      \G
                      (match (parse-ranged input ipos 4 1 9999)
                        (Maybe.Just v)
                          (do
                            (set! iso-y v)
                            (set! ipos (+ ipos 4))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do (set! err @"failed to parse %G") (set! ok false)))
                      \u
                      (match (parse-ranged input ipos 1 1 7)
                        (Maybe.Just v)
                          (do
                            (set! wd (Int.dec v))
                            (set! ipos (+ ipos 1))
                            (set! fpos (+ fpos 2)))
                        (Maybe.Nothing)
                          (do
                            (set! err @"failed to parse %u: expected 1-7")
                            (set! ok false)))
                      \z
                      (if (> (+ ipos 5) ilen)
                        (do (set! err @"failed to parse %z") (set! ok false))
                        (let [sign-c (String.char-at input ipos)]
                          (if (or (= sign-c \+) (= sign-c \-))
                            (match (parse-digits input (+ ipos 1) 2)
                              (Maybe.Just zh)
                                (match (parse-digits input (+ ipos 3) 2)
                                  (Maybe.Just zm)
                                    (let-do [sign-mult (if (= sign-c \-) -1l 1l)]
                                      (set! tz-delta
                                            (* sign-mult
                                               (+ (* (Long.from-int zh) 3600l)
                                                  (* (Long.from-int zm) 60l))))
                                      (set! has-tz true)
                                      (set! ipos (+ ipos 5))
                                      (set! fpos (+ fpos 2)))
                                  (Maybe.Nothing)
                                    (do
                                      (set! err @"failed to parse %z")
                                      (set! ok false)))
                              (Maybe.Nothing)
                                (do
                                  (set! err @"failed to parse %z")
                                  (set! ok false)))
                            (do (set! err @"failed to parse %z") (set! ok false)))))
                      \Z
                      (let-do [n 0]
                        (while (and (< (+ ipos n) ilen)
                                    (let [c (String.char-at input (+ ipos n))]
                                      (or (and (>= c \A) (<= c \Z))
                                          (and (>= c \a) (<= c \z)))))
                          (set! n (+ n 1)))
                        (if (> n 0)
                          (do
                            (set! tz-nm
                                  (String.byte-slice input ipos (+ ipos n)))
                            (set! has-tz true)
                            (set! ipos (+ ipos n))
                            (set! fpos (+ fpos 2)))
                          (do (set! err @"failed to parse %Z") (set! ok false))))
                      \%
                      (if (and (< ipos ilen) (= \% (String.char-at input ipos)))
                        (do (set! ipos (+ ipos 1)) (set! fpos (+ fpos 2)))
                        (do (set! err @"failed to parse %%") (set! ok false)))
                      (do
                        (set! err
                              (String.concat
                                &[@"unknown format specifier: %"
                                  (String.byte-slice &efmt (+ fpos 1) (+ fpos 2))]))
                        (set! ok false))))
            (and (< ipos ilen) (= fc (String.char-at input ipos)))
              (do (set! ipos (+ ipos 1)) (set! fpos (+ fpos 1)))
            (do
              (set! err
                    (String.concat
                      &[@"unexpected character at position " (Int.str ipos)]))
              (set! ok false)))))
      (if ok
        (match (cond
            (and (> mo 0) (> dy 0)) (Result.Success (date yr mo dy))
            (> jd 0)
              (if has-year
                (date-from-yearday yr jd)
                (Result.Error @"%j needs a year (%Y or %y)"))
            (or (> iso-y 0) (> iso-w 0))
              (if (and (> iso-y 0) (and (> iso-w 0) (> wd -1)))
                (date-from-isoweek iso-y iso-w wd)
                (Result.Error
                  @"ISO week dates need %G, %V and a weekday (%u, %w, %a or %A)"))
            (> wk -1)
              (if (and has-year (> wd -1))
                (date-from-week yr wk wd wk-monday?)
                (Result.Error
                  @"%U and %W need a year and a weekday (%u, %w, %a or %A)"))
            (Result.Success (date yr mo dy)))
          (Result.Error e) (Result.Error e)
          (Result.Success d)
            (let [final-hr (cond
                    (= hr -1) hr
                    (= ampm 2) (if (< hr 12) (+ hr 12) hr)
                    (= ampm 1) (if (= hr 12) 0 hr)
                    hr)
                  hours-val (if (= final-hr -1)
                    (Maybe.Nothing)
                    (Maybe.Just final-hr))
                  minutes-val (if (= mi -1) (Maybe.Nothing) (Maybe.Just mi))
                  seconds-val (if (= sc -1) (Maybe.Nothing) (Maybe.Just sc))
                  ns-val (if (= ns -1) (Maybe.Nothing) (Maybe.Just ns))
                  tz-val (if has-tz
                    (Maybe.Just (Timezone.init @&tz-nm tz-delta false))
                    (Maybe.Nothing))]
              (Result.Success
                (init @(year &d)
                      @(month &d)
                      @(day &d)
                      hours-val
                      minutes-val
                      seconds-val
                      ns-val
                      tz-val))))
        (Result.Error @&err))))

  (doc = "is defined as the equality of all members of `a` and `b`, even the
optional ones.")
  (defn = [a b]
    (and (= (year a) (year b))
         (= (month a) (month b))
         (= (day a) (day b))
         (= (hours a) (hours b))
         (= (minutes a) (minutes b))
         (= (seconds a) (seconds b))
         (= (nanoseconds a) (nanoseconds b))
         (= &(Maybe.from @(tz a) @&Timezone.utc)
            &(Maybe.from @(tz b) @&Timezone.utc))))
  (implements = Datetime.=)

  (doc > "is defined as the timezone-unaware comparison of `a` and `b`.")
  (defn > [a b]
    (cond
      (/= @(year a) @(year b)) (> @(year a) @(year b))
      (/= @(month a) @(month b)) (> @(month a) @(month b))
      (/= @(day a) @(day b)) (> @(day a) @(day b))
      (let [ha (Maybe.from @(hours a) 0)
            hb (Maybe.from @(hours b) 0)]
        (if (/= ha hb)
          (> ha hb)
          (let [ma (Maybe.from @(minutes a) 0)
                mb (Maybe.from @(minutes b) 0)]
            (if (/= ma mb)
              (> ma mb)
              (let [sa (Maybe.from @(seconds a) 0)
                    sb (Maybe.from @(seconds b) 0)]
                (if (/= sa sb)
                  (> sa sb)
                  (> (Maybe.from @(nanoseconds a) 0)
                     (Maybe.from @(nanoseconds b) 0))))))))))
  (implements > Datetime.>)

  (doc < "is defined as the timezone-unaware comparison of `a` and `b`.")
  (defn < [a b]
    (cond
      (/= @(year a) @(year b)) (< @(year a) @(year b))
      (/= @(month a) @(month b)) (< @(month a) @(month b))
      (/= @(day a) @(day b)) (< @(day a) @(day b))
      (let [ha (Maybe.from @(hours a) 0)
            hb (Maybe.from @(hours b) 0)]
        (if (/= ha hb)
          (< ha hb)
          (let [ma (Maybe.from @(minutes a) 0)
                mb (Maybe.from @(minutes b) 0)]
            (if (/= ma mb)
              (< ma mb)
              (let [sa (Maybe.from @(seconds a) 0)
                    sb (Maybe.from @(seconds b) 0)]
                (if (/= sa sb)
                  (< sa sb)
                  (< (Maybe.from @(nanoseconds a) 0)
                     (Maybe.from @(nanoseconds b) 0))))))))))
  (implements < Datetime.<)

  (doc equal-instant? "checks whether `a` and `b` name the same instant.

Unlike `=`, which compares the wall-clock fields directly and is timezone-
unaware, this compares the two `Datetime`s as UTC instants (via
[`to-utc`](#to-utc)), so e.g. `14:00 EST` and `19:00 UTC` are equal. The
comparison is to the second, with `nanoseconds` as the tiebreaker.")
  (defn equal-instant? [a b]
    (let [ua (to-utc a)
          ub (to-utc b)] (and (not (< &ua &ub)) (not (> &ua &ub)))))

  (doc before-instant? "checks whether `a` names an earlier instant than `b`,
comparing them as UTC instants (see [`equal-instant?`](#equal-instant?)). This is
the timezone-aware counterpart to `<`.")
  (defn before-instant? [a b] (< &(to-utc a) &(to-utc b)))

  (doc after-instant? "checks whether `a` names a later instant than `b`,
comparing them as UTC instants (see [`equal-instant?`](#equal-instant?)). This is
the timezone-aware counterpart to `>`.")
  (defn after-instant? [a b] (before-instant? b a))

  (doc diff "returns the signed difference in seconds between `a` and `b`.

The result is positive when `a` is later than `b`, and negative when `a` is
earlier. This is a timezone-unaware comparison, similar to `>` and `<`.")
  (defn diff [a b]
    (let [ord-a (to-ordinal a)
          ord-b (to-ordinal b)
          time-a (+ (* (Maybe.from @(hours a) 0) HOUR)
                    (+ (* (Maybe.from @(minutes a) 0) MINUTE)
                       (Maybe.from @(seconds a) 0)))
          time-b (+ (* (Maybe.from @(hours b) 0) HOUR)
                    (+ (* (Maybe.from @(minutes b) 0) MINUTE)
                       (Maybe.from @(seconds b) 0)))]
      (+ (* (- ord-a ord-b) DAY) (- time-a time-b))))

  (doc add-months "adds `n` months to the `Datetime` `dt`.

If the resulting month has fewer days than the original day, the day is clamped
to the last day of the month. For example, adding 1 month to January 31 yields
February 28 (or 29 in a leap year).

`n` may be negative to subtract months.")
  (defn add-months [dt n]
    (let [total (+ (+ (* @(year dt) 12) (Int.dec @(month dt))) n)
          new-year (div- total 12)
          new-month (+ (mod- total 12) 1)
          max-day (days-in-month new-year new-month)
          new-day (min @(day dt) max-day)]
      (init new-year
            new-month
            new-day
            @(hours dt)
            @(minutes dt)
            @(seconds dt)
            @(nanoseconds dt)
            @(tz dt))))

  (doc add-years "adds `n` years to the `Datetime` `dt`.

If the date is February 29 and the resulting year is not a leap year, the day is
clamped to February 28.

`n` may be negative to subtract years.")
  (defn add-years [dt n]
    (let [new-year (+ @(year dt) n)
          max-day (days-in-month new-year @(month dt))
          new-day (min @(day dt) max-day)]
      (init new-year
            @(month dt)
            new-day
            @(hours dt)
            @(minutes dt)
            @(seconds dt)
            @(nanoseconds dt)
            @(tz dt)))))

(deftype Duration [seconds- Int])

(doc Duration "this is a complementary module to be used with `Datetime` and
is concerned with adding and subtracting time values of the scale from seconds
to weeks from `Datetime` values.

Example:
```
(load \"git@github.com:carpentry-org/time@0.5.3\")

(defn main []
  (println*
    &(Datetime.strftime
      &(Duration.sub &(Datetime.now) &(Duration.days 2))
      \"%Y-%m-%d %I:%M:%S.%n %p %z\")))
```
")
(defmodule Duration
  (hidden seconds-)
  (private seconds-)
  (hidden set-seconds-)
  (private set-seconds-)
  (hidden set-seconds-!)
  (private set-seconds-!)
  (hidden update-seconds-!)
  (private update-seconds-!)
  (hidden update-seconds-)
  (private update-seconds-)
  (hidden init)
  (private init)

  (doc seconds "creates a delta representing a number of seconds `n`.")
  (defn seconds [n] (init n))
  (doc minutes "creates a delta representing a number of minutes `n`.")
  (defn minutes [n] (seconds (* n 60)))
  (doc hours "creates a delta representing a number of hours `n`.")
  (defn hours [n] (minutes (* n 60)))
  (doc days "creates a delta representing a number of days `n`.")
  (defn days [n] (hours (* n 24)))
  (doc weeks "creates a delta representing a number of weeks `n`.")
  (defn weeks [n] (days (* n 7)))

  (doc add "adds a `Duration` `delta` to a `Datetime` `dt`.")
  (defn add [dt delta] (Datetime.add-seconds dt @(seconds- delta)))

  (doc sub "subtracts a `Duration` `delta` from a `Datetime` `dt`.")
  (defn sub [dt delta] (Datetime.add-seconds dt (neg @(seconds- delta))))

  (doc between
    "returns the signed difference between the `Datetime`s `a` and `b`
as a `Duration`.

The result is positive when `a` is later than `b`, and negative when `a` is
earlier, mirroring `Datetime.diff`.")
  (defn between [a b] (init (Datetime.diff a b)))

  (doc to-seconds "returns the total number of seconds represented by the delta
`d`.")
  (defn to-seconds [d] @(seconds- d))

  (doc to-minutes "returns the total number of whole minutes represented by the
delta `d`, truncating any remaining seconds toward zero.")
  (defn to-minutes [d] (/ @(seconds- d) 60))

  (doc to-hours
    "returns the total number of whole hours represented by the delta
`d`, truncating any remainder toward zero.")
  (defn to-hours [d] (/ @(seconds- d) 3600))

  (doc to-days "returns the total number of whole days represented by the delta
`d`, truncating any remainder toward zero.")
  (defn to-days [d] (/ @(seconds- d) 86400))

  (doc plus "returns the sum of the deltas `a` and `b`.")
  (defn plus [a b] (init (+ @(seconds- a) @(seconds- b))))

  (doc minus "returns the difference of the deltas `a` and `b`.")
  (defn minus [a b] (init (- @(seconds- a) @(seconds- b))))

  (doc negate "returns the delta `d` with its sign flipped.")
  (defn negate [d] (init (neg @(seconds- d))))

  (doc scale "returns the delta `d` scaled by the integer factor `n`.")
  (defn scale [d n] (init (* @(seconds- d) n)))

  (doc mul "returns the delta `d` scaled by the integer factor `n`. An alias for
`scale`.")
  (defn mul [d n] (scale d n))

  (doc = "checks whether the deltas `a` and `b` represent the same duration.")
  (defn = [a b] (Int.= @(seconds- a) @(seconds- b)))
  (implements = Duration.=)

  (doc < "checks whether the delta `a` is shorter than the delta `b`.")
  (defn < [a b] (Int.< @(seconds- a) @(seconds- b)))
  (implements < Duration.<)

  (doc > "checks whether the delta `a` is longer than the delta `b`.")
  (defn > [a b] (Int.> @(seconds- a) @(seconds- b)))
  (implements > Duration.>)

  (doc zero? "checks whether the delta `d` represents no elapsed time.")
  (defn zero? [d] (Int.= @(seconds- d) 0))

  (doc pos? "checks whether the delta `d` represents a positive duration.")
  (defn pos? [d] (Int.> @(seconds- d) 0))

  (doc neg? "checks whether the delta `d` represents a negative duration.")
  (defn neg? [d] (Int.< @(seconds- d) 0))

  (doc str
    "renders the delta `d` in a human-readable form such as `1d 2h 3m 4s`.

Components that are zero are omitted, a negative delta is prefixed with a `-`,
and the zero delta renders as `0s`.")
  (defn str [d]
    (let [total @(seconds- d)]
      (if (Int.= total 0)
        @"0s"
        (let-do [a (Int.abs total)
                 days (/ a 86400)
                 hrs (/ (mod a 86400) 3600)
                 mins (/ (mod a 3600) 60)
                 secs (mod a 60)
                 parts []]
          (when (> days 0) (Array.push-back! &parts (fmt "%dd" days)))
          (when (> hrs 0) (Array.push-back! &parts (fmt "%dh" hrs)))
          (when (> mins 0) (Array.push-back! &parts (fmt "%dm" mins)))
          (when (> secs 0) (Array.push-back! &parts (fmt "%ds" secs)))
          (String.concat
            &[(if (Int.< total 0) @"-" @"") (String.join " " &parts)])))))
  (implements str Duration.str))
